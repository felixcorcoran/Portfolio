        <!-- Cambio de idioma sin perder el sitio. Al pulsar ES/EN se apunta qué
             se está leyendo (el elemento más concreto bajo una línea a un 30 % de
             la pantalla y por dónde va), la página se difumina y carga el otro
             idioma; allí aparece ya en ese mismo elemento y se enfoca. Se usa el
             elemento, no los píxeles: el texto en inglés no mide lo mismo.
             Va inline al final del body: coloca la página antes de que corran
             las animaciones de entrada (script de abajo). -->
        <script is:inline>
            (() => {
                const KEY = 'lang-switch';
                const root = document.documentElement;
                const main = document.querySelector('main');
                const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
                const probe = () => innerHeight * 0.3;
                // Las dos versiones comparten plantilla: mismos elementos, mismo orden
                const anchors = () => Array.from(main.querySelectorAll('section, h1, h2, h3, h4, p, li, img'));

                const reading = () => {
                    const list = anchors();
                    const y = probe();
                    let index = -1;
                    let height = Infinity;
                    let ratio = 0;
                    list.forEach((el, i) => {
                        const r = el.getBoundingClientRect();
                        if (r.height > 0 && r.top <= y && r.bottom > y && r.height < height) {
                            index = i;
                            height = r.height;
                            ratio = (y - r.top) / r.height;
                        }
                    });
                    const max = root.scrollHeight - innerHeight;
                    return { index, total: list.length, ratio, share: max > 0 ? scrollY / max : 0 };
                };

                for (const link of document.querySelectorAll('a[data-lang-switch]')) {
                    // La otra versión, precargada al acercarse al botón
                    link.addEventListener('pointerenter', () => {
                        if (link.dataset.prefetched || link.getAttribute('aria-current')) return;
                        link.dataset.prefetched = '1';
                        const hint = document.createElement('link');
                        hint.rel = 'prefetch';
                        hint.href = link.href;
                        document.head.append(hint);
                    }, { once: true });

                    link.addEventListener('click', (event) => {
                        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                        event.preventDefault();
                        if (link.getAttribute('aria-current')) return;
                        try {
                            sessionStorage.setItem(KEY, JSON.stringify(reading()));
                        } catch {}
                        if (reduce) {
                            location.href = link.href;
                            return;
                        }
                        root.classList.add('lang-leaving');
                        setTimeout(() => (location.href = link.href), 320);
                    });
                }

                // Al volver con «atrás» desde la otra versión, la página guardada
                // en memoria no puede quedarse difuminada
                addEventListener('pageshow', (event) => {
                    if (event.persisted) root.classList.remove('lang-leaving');
                });

                let saved = null;
                try {
                    saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
                    sessionStorage.removeItem(KEY);
                } catch {}
                if (!saved) {
                    root.classList.remove('lang-arriving');
                    return;
                }

                const place = () => {
                    const list = anchors();
                    const el = saved.index >= 0 && saved.total === list.length ? list[saved.index] : null;
                    let top;
                    if (el) {
                        const r = el.getBoundingClientRect();
                        top = scrollY + r.top + saved.ratio * r.height - probe();
                    } else {
                        top = saved.share * (root.scrollHeight - innerHeight);
                    }
                    window.scrollTo({ top: Math.max(0, top), behavior: 'instant' });
                };
                place();

                // Lo que ya está en pantalla se muestra tal cual: la única animación
                // es la del cambio, no las entradas de cada sección otra vez
                const inView = (el) => {
                    const r = el.getBoundingClientRect();
                    return r.bottom > 0 && r.top < innerHeight;
                };
                main.querySelectorAll('[data-reveal]').forEach((el) => {
                    if (inView(el)) el.classList.add('is-in', 'no-anim');
                });
                main.querySelectorAll('.exp-row, .exp-title-line').forEach((el) => {
                    if (!inView(el)) return;
                    el.style.transition = 'none';
                    el.classList.add('is-in');
                });

                // Si las fuentes o imágenes cambian la altura, se recoloca, salvo
                // que la persona ya haya empezado a moverse
                let moved = false;
                const mark = () => (moved = true);
                for (const type of ['wheel', 'touchstart', 'keydown', 'mousedown']) addEventListener(type, mark, { passive: true, once: true });
                const again = () => moved || place();
                document.fonts?.ready.then(again);
                addEventListener('load', again, { once: true });

                // Aparece: con la transición ya puesta (se fuerza el estilo) se quita
                // el estado oculto. Temporizador y no requestAnimationFrame: con la
                // pestaña en segundo plano rAF no corre y la página se quedaría oculta
                setTimeout(() => {
                    root.classList.add('lang-arrived');
                    void main.offsetWidth;
                    root.classList.remove('lang-arriving');
                    // Pase lo que pase (pestaña oculta, sin fotogramas), al final se ve
                    setTimeout(() => {
                        main.getAnimations().forEach((animation) => animation.finish());
                        root.classList.remove('lang-arrived');
                    }, 800);
                }, 30);
            })();
        </script>
    </body>
</html>

<style is:global>
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; }

    /* ---------- Cambio de idioma (script del final del body) ----------
       Se va: el contenido se difumina. Llega: empieza oculto ya colocado en
       el mismo punto y se enfoca. Solo opacidad y desenfoque: sin mover nada. */
    html.lang-leaving main {
        opacity: 0;
        filter: blur(12px);
        transition: opacity 0.3s ease, filter 0.3s ease;
    }
    html.lang-arriving main {
        opacity: 0;
        filter: blur(12px);
    }
    html.lang-arrived main {
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* Lo que ya estaba en pantalla al llegar no repite su entrada */
    .no-anim, .no-anim * { animation: none !important; }

    #stack-title { will-change: transform, opacity; }

    @keyframes reveal {
        0% { transform: translateY(50px); opacity: 0; filter: blur(20px); }
        100% { transform: translateY(0); opacity: 1; filter: blur(0); }
    }
    h1 { animation: reveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .animate-fade-in { animation: fade-in 2s ease-out forwards; }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 10px; }

    @keyframes reveal-up {
        0% {
            transform: translateY(100%);
            clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
        }
        100% {
            transform: translateY(0);
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }
    }

    .animate-reveal-up {
        animation: reveal-up 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    }

    /* ---------- Experiencia ----------
       Solo con JS (el script añade .exp-anim): sin él, todo se ve tal cual.
       El titular sube desde abajo; cada puesto entra desenfocado y se enfoca,
       y su punto en la línea de tiempo se enciende. */
    .exp-anim .exp-title-line {
        transform: translateY(105%);
        transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .exp-anim .exp-title-line.is-in { transform: none; }

    .exp-anim .exp-row {
        opacity: 0;
        transform: translateY(48px);
        filter: blur(8px);
        transition:
            opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
            filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .exp-anim .exp-row.is-in { opacity: 1; transform: none; filter: none; }

    .exp-row.is-on .exp-dot {
        border-color: #60a5fa;
        background: #3b82f6;
        box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.15), 0 0 24px rgba(99, 102, 241, 0.6);
    }

    #exp-progress { transform: scaleY(0); }

    /* ---------- Entradas al llegar ----------
       Con movimiento, el script añade .anim a <html> y cada [data-reveal]
       recibe .is-in al entrar en pantalla. Sus piezas:
         rv-up / rv-word  suben desde su máscara (overflow oculto)
         rv-fade          aparece subiendo
         rv-card          sube, crece un poco y se enfoca
         rv-line          se dibuja de izquierda a derecha
       --i escalona. Son animaciones (no transiciones) para no tocar los
       efectos de hover y foco que ya tienen esos mismos elementos. */
    @keyframes rv-up { from { transform: translateY(110%); } }
    @keyframes rv-fade { from { opacity: 0; transform: translateY(24px); } }
    @keyframes rv-card { from { opacity: 0; transform: translateY(40px) scale(0.97); filter: blur(6px); } }
    @keyframes rv-line { from { transform: scaleX(0); } }

    .anim [data-reveal]:not(.is-in) :is(.rv-up, .rv-word) { transform: translateY(110%); }
    .anim [data-reveal]:not(.is-in) .rv-fade,
    .anim .rv-card[data-reveal]:not(.is-in) { opacity: 0; }
    .anim [data-reveal]:not(.is-in) .rv-line { transform: scaleX(0); }

    .rv-line { transform-origin: left center; }

    .anim .is-in :is(.rv-up, .rv-word) { animation: rv-up 1s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms) both; }
    .anim .is-in .rv-fade { animation: rv-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 110ms) both; }
    .anim .rv-card.is-in { animation: rv-card 0.9s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms) both; }
    .anim .is-in .rv-line { animation: rv-line 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both; }

    /* ---------- Animaciones propias de cada zona ----------
       Portada: los enlaces de contacto entran desde la izquierda.
       Proyectos: la captura se descubre de abajo arriba (rv-wipe) o de
       derecha a izquierda en la tarjeta ancha (rv-wipe-x).
       Stack: los grupos giran hacia ti (rv-flip) y los iconos aparecen de
       uno en uno con un pequeño rebote (rv-pop).
       Pie: la firma cierra el espaciado de sus letras (rv-track). */
    @keyframes hero-link { from { opacity: 0; transform: translateX(-16px); filter: blur(4px); } }
    .hero-link { animation: hero-link 0.9s cubic-bezier(0.16, 1, 0.3, 1) calc(0.9s + var(--i, 0) * 120ms) both; }

    @keyframes rv-wipe { from { clip-path: inset(100% 0 0 0); } }
    @keyframes rv-wipe-img { from { transform: scale(1.18); } }
    @keyframes rv-wipe-x { from { clip-path: inset(0 0 0 100%); } }
    @keyframes rv-flip { from { opacity: 0; transform: perspective(900px) rotateY(-28deg) translateX(-24px); } }
    @keyframes rv-pop { 0% { opacity: 0; transform: scale(0.4); } 70% { opacity: 1; transform: scale(1.12); } 100% { transform: scale(1); } }
    @keyframes rv-track { from { opacity: 0; letter-spacing: 0.45em; filter: blur(6px); } }

    .anim [data-reveal]:not(.is-in) :is(.rv-wipe, .rv-wipe-x) { clip-path: inset(100% 0 0 0); }
    .anim [data-reveal]:not(.is-in) :is(.rv-pop, .rv-track),
    .anim .rv-flip[data-reveal]:not(.is-in) { opacity: 0; }

    .anim .is-in .rv-wipe { animation: rv-wipe 1.1s cubic-bezier(0.77, 0, 0.175, 1) calc(var(--i, 0) * 120ms) both; }
    .anim .is-in .rv-wipe img { animation: rv-wipe-img 1.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 120ms) both; }
    .anim .is-in .rv-wipe-x { animation: rv-wipe-x 1.2s cubic-bezier(0.77, 0, 0.175, 1) 0.1s both; }
    .anim .is-in .rv-wipe-x img { animation: rv-wipe-img 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
    .anim .rv-flip.is-in { animation: rv-flip 1s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 130ms) both; transform-origin: left center; }
    .anim .is-in .rv-pop { animation: rv-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.35s + var(--i, 0) * 130ms + var(--j, 0) * 45ms) both; }
    .anim .is-in .rv-track { animation: rv-track 1.2s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 150ms) both; }

    /* En una columna cada tarjeta entra sola al llegar: sin esperar a sus vecinas */
    @media (max-width: 639px) {
        .rv-card, .rv-flip, .rv-flip .rv-pop { --i: 0 !important; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-link { animation: none; }
        .exp-anim .exp-title-line,
        .exp-anim .exp-row { opacity: 1; transform: none; filter: none; transition: none; }
        #exp-progress { transform: none; }
    }
</style>

<script>
    const stackTitle = document.querySelector('#stack-title') as HTMLElement;

    const handleScroll = () => {
        if (stackTitle) {
            const rectStack = stackTitle.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollPercentStack = Math.min(Math.max((windowHeight - rectStack.top) / (windowHeight * 0.9), 0), 1);
            stackTitle.style.transform = `translateX(${(1 - scrollPercentStack) * -80}%)`;
            stackTitle.style.opacity = scrollPercentStack.toString();
        }
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                if (entry.target.id === 'trigger-build') {
                    const spans = entry.target.querySelectorAll('.reveal-text');
                    spans.forEach(span => {
                        span.classList.remove('translate-y-full', 'opacity-0');
                        span.classList.add('translate-y-0', 'opacity-100');
                    });
                    observer.unobserve(entry.target);
                }
            }
        });
    }, { threshold: 0.9 }); 

    const triggerBuild = document.querySelector('#trigger-build');
    if (triggerBuild) observer.observe(triggerBuild);

    const revealSpans = document.querySelectorAll('.reveal-text');
    revealSpans.forEach(span => observer.observe(span));

    window.addEventListener('scroll', handleScroll);
    handleScroll();

    // El botón ES/EN se aparta al bajar (para no taparse con los titulares) y
    // vuelve al subir o al llegar arriba
    const langNav = document.getElementById('lang-nav');
    let lastY = scrollY;
    window.addEventListener('scroll', () => {
        if (!langNav) return;
        const y = scrollY;
        if (y > 240 && y > lastY + 4) langNav.style.transform = 'translateY(-160%)';
        else if (y < lastY - 4 || y < 240) langNav.style.transform = '';
        lastY = y;
    }, { passive: true });
    langNav?.addEventListener('focusin', () => (langNav.style.transform = ''));

    // ---------- Experiencia ----------
    // La línea de tiempo se rellena con el scroll (de que la lista asoma por
    // abajo a que su final pasa por el centro de la pantalla) y enciende el
    // punto de cada puesto al llegar a él. Los puestos entran escalonados.
    const expSection = document.getElementById('experiencia');
    const expList = document.getElementById('exp-list');
    const expProgress = document.getElementById('exp-progress');
    const expRows = Array.from(document.querySelectorAll<HTMLElement>('.exp-row'));
    const expTitle = document.querySelector<HTMLElement>('.exp-title-line');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (expSection && expList && expProgress) {
        expSection.classList.add('exp-anim');

        const updateTimeline = () => {
            const rect = expList.getBoundingClientRect();
            const progress = reduceMotion
                ? 1
                : Math.min(Math.max((innerHeight * 0.75 - rect.top) / rect.height, 0), 1);
            expProgress.style.transform = `scaleY(${progress})`;
            const reached = rect.top + rect.height * progress;
            for (const row of expRows) {
                const dot = row.querySelector('.exp-dot') as HTMLElement | null;
                const dotY = dot ? dot.getBoundingClientRect().top : row.getBoundingClientRect().top;
                row.classList.toggle('is-on', dotY <= reached);
            }
        };

        const expObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                // El titular se observa por su contenedor: la línea, desplazada
                // fuera de su caja con overflow oculto, nunca «se vería»
                const target = el.id === 'exp-title' ? expTitle : el;
                const index = expRows.indexOf(el);
                if (target) {
                    target.style.transitionDelay = index > 0 ? `${index * 120}ms` : '';
                    target.classList.add('is-in');
                }
                expObserver.unobserve(el);
            });
        }, { threshold: 0.25 });

        expRows.forEach((row) => expObserver.observe(row));
        const expTitleBox = document.getElementById('exp-title');
        if (expTitleBox) expObserver.observe(expTitleBox);

        window.addEventListener('scroll', updateTimeline, { passive: true });
        window.addEventListener('resize', updateTimeline);
        updateTimeline();
    }

    // ---------- Entradas al llegar ([data-reveal], ver los estilos) ----------
    if (!reduceMotion) document.documentElement.classList.add('anim');
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
        });
    }, { threshold: 0.2 });
    document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

    // ---------- «TRABAJOS»: el contorno se rellena con el scroll ----------
    // Del titular asomando por abajo a llegar a algo más de media pantalla
    const projectsFill = document.getElementById('projects-fill');
    const updateFill = () => {
        if (!projectsFill) return;
        if (reduceMotion) {
            projectsFill.style.clipPath = 'none';
            return;
        }
        const rect = projectsFill.getBoundingClientRect();
        const progress = Math.min(Math.max((innerHeight * 0.9 - rect.top) / (innerHeight * 0.5), 0), 1);
        projectsFill.style.clipPath = `inset(0 ${(1 - progress) * 100}% 0 0)`;
    };
    window.addEventListener('scroll', updateFill, { passive: true });
    window.addEventListener('resize', updateFill);
    updateFill();

    const form = document.getElementById('contact-form');
    const btnText = document.getElementById('btn-text');
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.getElementById('submit-btn');

    // Textos del botón en el idioma de la página (data-* del formulario)
    const label = form.dataset;

    // El botón vuelve a estar disponible: tras un éxito (pasado un rato) o
    // tras un error (al momento, para poder reintentar)
    const enable = () => {
        submitBtn.style.pointerEvents = "auto";
        submitBtn.style.opacity = "1";
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        btnText.innerText = label.sending;
        submitBtn.style.pointerEvents = "none";
        submitBtn.style.opacity = "0.5";

        const formData = new FormData(form);

        try {
            const response = await fetch('/api/send-email', {
                method: 'POST',
                body: formData,
            });

            if (response.ok) {
                form.reset();
                btnText.innerText = label.sent;
                successMsg.classList.remove('hidden');
                setTimeout(() => {
                    successMsg.classList.add('hidden');
                    btnText.innerText = label.send;
                    enable();
                }, 5000);
            } else {
                btnText.innerText = label.error;
                enable();
            }
        } catch (error) {
            btnText.innerText = label.failed;
            enable();
        }
    });
</script>