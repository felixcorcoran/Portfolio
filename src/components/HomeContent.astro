</html>

<style is:global>
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; }

    #stack-title { will-change: transform, opacity; }

    @keyframes reveal {
        0% { transform: translateY(50px); opacity: 0; filter: blur(20px); }
        100% { transform: translateY(0); opacity: 1; filter: blur(0); }
    }
    h1 { animation: reveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .animate-fade-in { animation: fade-in 2s ease-out forwards; }

    .hover\:!grayscale-0:hover { filter: grayscale(0) !important; }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 10px; }

    @keyframes reveal-up {
        0% {
            transform: translateY(100%);
            clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
        }
        100% {
            transform: translateY(0);
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }
    }

    .animate-reveal-up {
        animation: reveal-up 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    }

    /* ---------- Experiencia ----------
       Solo con JS (el script añade .exp-anim): sin él, todo se ve tal cual.
       El titular sube desde abajo; cada puesto entra desenfocado y se enfoca,
       y su punto en la línea de tiempo se enciende. */
    .exp-anim .exp-title-line {
        transform: translateY(105%);
        transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .exp-anim .exp-title-line.is-in { transform: none; }

    .exp-anim .exp-row {
        opacity: 0;
        transform: translateY(48px);
        filter: blur(8px);
        transition:
            opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
            filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .exp-anim .exp-row.is-in { opacity: 1; transform: none; filter: none; }

    .exp-row.is-on .exp-dot {
        border-color: #60a5fa;
        background: #3b82f6;
        box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.15), 0 0 24px rgba(99, 102, 241, 0.6);
    }

    #exp-progress { transform: scaleY(0); }

    /* ---------- Entradas al llegar ----------
       Con movimiento, el script añade .anim a <html> y cada [data-reveal]
       recibe .is-in al entrar en pantalla. Sus piezas:
         rv-up / rv-word  suben desde su máscara (overflow oculto)
         rv-fade          aparece subiendo
         rv-card          sube, crece un poco y se enfoca
         rv-line          se dibuja de izquierda a derecha
       --i escalona. Son animaciones (no transiciones) para no tocar los
       efectos de hover y foco que ya tienen esos mismos elementos. */
    @keyframes rv-up { from { transform: translateY(110%); } }
    @keyframes rv-fade { from { opacity: 0; transform: translateY(24px); } }
    @keyframes rv-card { from { opacity: 0; transform: translateY(40px) scale(0.97); filter: blur(6px); } }
    @keyframes rv-line { from { transform: scaleX(0); } }

    .anim [data-reveal]:not(.is-in) :is(.rv-up, .rv-word) { transform: translateY(110%); }
    .anim [data-reveal]:not(.is-in) :is(.rv-fade, .rv-card) { opacity: 0; }
    .anim [data-reveal]:not(.is-in) .rv-line { transform: scaleX(0); }

    .rv-line { transform-origin: left center; }

    .anim .is-in :is(.rv-up, .rv-word) { animation: rv-up 1s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms) both; }
    .anim .is-in .rv-fade { animation: rv-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 110ms) both; }
    .anim .is-in .rv-card { animation: rv-card 0.9s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms) both; }
    .anim .is-in .rv-line { animation: rv-line 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both; }

    @media (prefers-reduced-motion: reduce) {
        .exp-anim .exp-title-line,
        .exp-anim .exp-row { opacity: 1; transform: none; filter: none; transition: none; }
        #exp-progress { transform: none; }
    }
</style>

<script>
    const stackTitle = document.querySelector('#stack-title') as HTMLElement;

    const handleScroll = () => {
        if (stackTitle) {
            const rectStack = stackTitle.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollPercentStack = Math.min(Math.max((windowHeight - rectStack.top) / (windowHeight * 0.9), 0), 1);
            stackTitle.style.transform = `translateX(${(1 - scrollPercentStack) * -80}%)`;
            stackTitle.style.opacity = scrollPercentStack.toString();
        }
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                if (entry.target.id === 'trigger-build') {
                    const spans = entry.target.querySelectorAll('.reveal-text');
                    spans.forEach(span => {
                        span.classList.remove('translate-y-full', 'opacity-0');
                        span.classList.add('translate-y-0', 'opacity-100');
                    });
                    observer.unobserve(entry.target);
                }
            }
        });
    }, { threshold: 0.9 }); 

    const triggerBuild = document.querySelector('#trigger-build');
    if (triggerBuild) observer.observe(triggerBuild);

    const revealSpans = document.querySelectorAll('.reveal-text');
    revealSpans.forEach(span => observer.observe(span));

    window.addEventListener('scroll', handleScroll);
    handleScroll();

    // ---------- Experiencia ----------
    // La línea de tiempo se rellena con el scroll (de que la lista asoma por
    // abajo a que su final pasa por el centro de la pantalla) y enciende el
    // punto de cada puesto al llegar a él. Los puestos entran escalonados.
    const expSection = document.getElementById('experiencia');
    const expList = document.getElementById('exp-list');
    const expProgress = document.getElementById('exp-progress');
    const expRows = Array.from(document.querySelectorAll<HTMLElement>('.exp-row'));
    const expTitle = document.querySelector<HTMLElement>('.exp-title-line');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (expSection && expList && expProgress) {
        expSection.classList.add('exp-anim');

        const updateTimeline = () => {
            const rect = expList.getBoundingClientRect();
            const progress = reduceMotion
                ? 1
                : Math.min(Math.max((innerHeight * 0.75 - rect.top) / rect.height, 0), 1);
            expProgress.style.transform = `scaleY(${progress})`;
            const reached = rect.top + rect.height * progress;
            for (const row of expRows) {
                const dot = row.querySelector('.exp-dot') as HTMLElement | null;
                const dotY = dot ? dot.getBoundingClientRect().top : row.getBoundingClientRect().top;
                row.classList.toggle('is-on', dotY <= reached);
            }
        };

        const expObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                // El titular se observa por su contenedor: la línea, desplazada
                // fuera de su caja con overflow oculto, nunca «se vería»
                const target = el.id === 'exp-title' ? expTitle : el;
                const index = expRows.indexOf(el);
                if (target) {
                    target.style.transitionDelay = index > 0 ? `${index * 120}ms` : '';
                    target.classList.add('is-in');
                }
                expObserver.unobserve(el);
            });
        }, { threshold: 0.25 });

        expRows.forEach((row) => expObserver.observe(row));
        const expTitleBox = document.getElementById('exp-title');
        if (expTitleBox) expObserver.observe(expTitleBox);

        window.addEventListener('scroll', updateTimeline, { passive: true });
        window.addEventListener('resize', updateTimeline);
        updateTimeline();
    }

    // ---------- Entradas al llegar ([data-reveal], ver los estilos) ----------
    if (!reduceMotion) document.documentElement.classList.add('anim');
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
        });
    }, { threshold: 0.2 });
    document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

    // ---------- «TRABAJOS»: el contorno se rellena con el scroll ----------
    // Del titular asomando por abajo a llegar a algo más de media pantalla
    const projectsFill = document.getElementById('projects-fill');
    const updateFill = () => {
        if (!projectsFill) return;
        if (reduceMotion) {
            projectsFill.style.clipPath = 'none';
            return;
        }
        const rect = projectsFill.getBoundingClientRect();
        const progress = Math.min(Math.max((innerHeight * 0.9 - rect.top) / (innerHeight * 0.5), 0), 1);
        projectsFill.style.clipPath = `inset(0 ${(1 - progress) * 100}% 0 0)`;
    };
    window.addEventListener('scroll', updateFill, { passive: true });
    window.addEventListener('resize', updateFill);
    updateFill();

    const form = document.getElementById('contact-form');
    const btnText = document.getElementById('btn-text');
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.getElementById('submit-btn');

    // Textos del botón en el idioma de la página (data-* del formulario)
    const label = form.dataset;

    // El botón vuelve a estar disponible: tras un éxito (pasado un rato) o
    // tras un error (al momento, para poder reintentar)
    const enable = () => {
        submitBtn.style.pointerEvents = "auto";
        submitBtn.style.opacity = "1";
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        btnText.innerText = label.sending;
        submitBtn.style.pointerEvents = "none";
        submitBtn.style.opacity = "0.5";

        const formData = new FormData(form);

        try {
            const response = await fetch('/api/send-email', {
                method: 'POST',
                body: formData,
            });

            if (response.ok) {
                form.reset();
                btnText.innerText = label.sent;
                successMsg.classList.remove('hidden');
                setTimeout(() => {
                    successMsg.classList.add('hidden');
                    btnText.innerText = label.send;
                    enable();
                }, 5000);
            } else {
                btnText.innerText = label.error;
                enable();
            }
        } catch (error) {
            btnText.innerText = label.failed;
            enable();
        }
    });
</script>