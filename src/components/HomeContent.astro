    }
    .tech svg { width: 60%; height: 60%; fill: currentColor; transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .tech-abbr { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; }
    .tech:hover {
