    }
    .tech:hover .tech-tip { opacity: 1; transform: translate(-50%, 0) scale(1); }
    /* En los bordes de la fila, la etiqueta se alinea hacia dentro */
    .tech[data-col="1"] .tech-tip { left: 0; transform: translateY(4px) scale(0.96); transform-origin: left bottom; }
