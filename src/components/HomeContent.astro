---
import '../styles/global.css';
import { useTranslations } from '../utils/i18n';
import { Image } from 'astro:assets';
import { persona, projects, experience, skills, learning, pick } from '../data/perfil';
import { techIcon } from '../data/iconos';

const title = "Félix Corcoran | Full Stack & AI Automation";
const { lang = 'es' } = Astro.props; 
const t = useTranslations(lang);

// URLs absolutas para buscadores y redes: la página en cada idioma
const site = Astro.site ?? new URL('https://dev.felixcorcoran.es');
const urlEs = new URL('/', site).href;
const urlEn = new URL('/en/', site).href;
const canonical = lang === 'en' ? urlEn : urlEs;

// Stack, Experiencia y Mis trabajos salen de src/data/perfil.ts, lo mismo que
// el currículum: se actualiza allí y cambian las dos cosas
const group = (id) => skills.find((s) => s.id === id)?.items ?? [];
const aiTools = [...group('ai'), ...group('integrations')];

const jobs = experience.map((job) => ({
    role: job.role[lang],
    place: job.company || 'Freelance',
    period: job.period[lang],
    desc: job.highlights.map((h) => h[lang]).join(' '),
    tags: job.tags.map((tag) => pick(tag, lang)),
}));

// Capturas de los proyectos y de las webs de clientes (src/assets/projects/*.jpg).
// Si hay una versión en inglés (<nombre>-en.jpg), la página en inglés usa esa
const shots = import.meta.glob('../assets/projects/*.jpg', { eager: true, import: 'default' });
const shot = (key) => (key ? shots[`../assets/projects/${key}-${lang}.jpg`] ?? shots[`../assets/projects/${key}.jpg`] : undefined);

const actions = { visit: t('btn.visit'), explore: t('btn.explore'), case: t('btn.case') };
const cards = projects
    .filter((p) => p.web)
    .map((p) => ({
        // En pantallas muy estrechas, un dominio se parte antes de «.es», nunca a mitad de palabra
        name: pick(p.name, lang).replace(/\.(?=[a-z]+$)/, '\u200b.'),
        url: p.web.url?.[lang] ?? p.url ?? null,
        tag: p.web.tag[lang],
        status: p.status?.[lang],
        desc: [p.summary[lang], ...p.highlights.map((h) => h[lang])].join(' '),
        chips: p.stack,
        action: actions[p.web.action ?? 'visit'],
        hover: p.web.hover?.[lang],
        repo: p.repo,
        mark: p.web.mark,
        wide: p.web.wide ?? false,
        first: p.web.first ?? false,
        client: p.web.client ?? false,
        image: shot(p.web.image),
        imagePos: p.web.imagePos ?? 'left top',
    }));
const halfCards = cards.filter((c) => !c.wide);
const wideCards = cards.filter((c) => c.wide);
// En móvil, los trabajos para clientes (Spain Trading Cards) van con las webs para negocios
const clientCards = cards.filter((c) => c.client);

// Stack en una pantalla: cuatro grupos (de perfil.ts) con su frase y sus iconos,
// en filas de cinco. Sin icono propio (REST), la casilla lleva las siglas
const tech = (name) => ({ name, icon: techIcon[name] });
const stackGroups = [
    { label: t('stack.backend'), text: t('stack.backend.text'), items: group('backend').map(tech) },
    { label: t('stack.frontend'), text: t('stack.frontend.text'), items: group('frontend').map(tech) },
    { label: t('stack.ai'), text: t('stack.ai.text'), items: aiTools.map(tech) },
    { label: t('stack.tools'), text: t('stack.tools.text'), items: group('tools').map(tech), alignEnd: true },
];
// Columna de cada casilla en la fila de cinco. Con alignEnd, la última fila
// incompleta empieza por la derecha (Herramientas, en espejo con Backend)
const col = (g, j) => {
    const rest = g.items.length % 5;
    const inLastRow = j >= g.items.length - rest;
    return (j % 5) + 1 + (g.alignEnd && rest && inLastRow ? 5 - rest : 0);
};
const learningIcons = learning.map(tech);

// Titulares que entran letra a letra (cada palabra junta, para que no se parta)
const letters = (text) => text.split(' ').map((word) => [...word]);

// Galería freelance: cada web con su captura
const clientSites = [
    { name: 'MBH Builders', url: 'https://mbhbuilders.es/inicio.html', cat: { es: 'Construcción', en: 'Construction' }, image: 'mbh', desc: { es: 'Web de una empresa de construcción.', en: 'Website for a construction company.' } },
    { name: 'Pilar Peluquería', url: 'https://pilarpeluqueria.com/inicio.html', cat: { es: 'Peluquería', en: 'Hair salon' }, image: 'pilar', desc: { es: 'Web bilingüe, servicios y solicitud de citas.', en: 'Bilingual website, services and appointment requests.' } },
    { name: 'Reformas Paola', url: 'https://reformasymantenimientospaola.com/inicio', cat: { es: 'Reformas', en: 'Renovations' }, image: 'paola', desc: { es: 'Web bilingüe y solicitud de presupuestos.', en: 'Bilingual website and quote requests.' } },
    { name: 'Ávila Secretaría Online', url: 'https://avilasecretariaonline.com/', cat: { es: 'Servicios', en: 'Services' }, image: 'avila', desc: { es: 'Web bilingüe de un servicio de secretaría online.', en: 'Bilingual website for an online secretarial service.' } },
    { name: 'Susana Floria Nails', url: 'https://susanaflorianails.com/sobrenosotros.html', cat: { es: 'Estética', en: 'Beauty' }, image: 'susana', desc: { es: 'Web de un negocio de estética.', en: 'Website for a beauty business.' } },
    { name: 'Construcciones Omega', url: 'https://construccionesyserviciosomega.com/inicio', cat: { es: 'Construcción', en: 'Construction' }, image: 'omega', desc: { es: 'Web de una empresa de construcción.', en: 'Website for a construction company.' } },
].map((s) => ({ ...s, cat: s.cat[lang], desc: s.desc[lang], image: shot(s.image) }));
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <!-- El monograma «fc» de la marca, en la paleta oscura e índigo del portfolio -->
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={t('seo.description')}>
        <title>{title}</title>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={urlEs} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlEs} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={t('seo.description')} />
        <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
        <meta property="og:image" content={new URL('/og.png', site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <!-- Cambio de idioma: si se llega desde el otro idioma, la página empieza
             oculta para aparecer ya en el punto donde se estaba (script del final) -->
        <script is:inline>
            try {
                if (sessionStorage.getItem('lang-switch')) {
                    document.documentElement.classList.add('lang-arriving');
                    history.scrollRestoration = 'manual';
                }
            } catch {}
        </script>
    </head>
    <body class="bg-neutral-950 text-white selection:bg-blue-500/30 font-sans">
        
        <nav id="lang-nav" class="fixed top-6 right-6 z-50 transition-transform duration-500 flex items-center gap-2 font-mono text-[10px] tracking-[0.3em] uppercase bg-neutral-900/40 backdrop-blur-md px-4 py-2 rounded-full border border-white/5">
            <a href="/" hreflang="es" data-lang-switch aria-current={lang === 'es' ? 'page' : undefined} class={lang === 'es' ? 'text-blue-400 font-bold' : 'text-neutral-400 hover:text-white transition-colors duration-300'}>ES</a>
            <span class="text-neutral-800">/</span>
            <a href="/en/" hreflang="en" data-lang-switch aria-current={lang === 'en' ? 'page' : undefined} class={lang === 'en' ? 'text-indigo-400 font-bold' : 'text-neutral-400 hover:text-white transition-colors duration-300'}>EN</a>
        </nav>
        
        <main>
            <section id="portada" class="relative min-h-svh md:min-h-screen flex items-center justify-center bg-[#050505] px-6 pt-[max(4.25rem,9svh)] pb-[4svh] md:pt-24 md:pb-16 overflow-hidden">
                <div class="absolute inset-0 -z-10 overflow-hidden">
                    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-600/15 blur-[120px] animate-pulse"></div>
                    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-600/15 blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30%] h-[30%] rounded-full bg-blue-400/5 blur-[100px]"></div>
                    
                    <div class="absolute left-10 top-1/2 -translate-y-1/2 hidden lg:block">
                        <span class="text-[10px] font-mono uppercase tracking-[1em] text-neutral-800 [writing-mode:vertical-lr]">
                            {t('hero.side')}
                        </span>
                    </div>
                </div>

                <div class="max-w-7xl w-full">
                    <div class="flex flex-col gap-[3svh] md:gap-10">
                        <div class="flex items-center gap-4 animate-fade-in">
                            <div class="flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/5 backdrop-blur-md">
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                                </span>
                                <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-blue-400">{t('hero.remote')}</span>
                            </div>
                            <span class="text-[9px] uppercase tracking-[0.4em] text-neutral-400 font-medium">{t('hero.bilingual')}</span>
                        </div>

                        <div class="relative">
                            <h1 class="text-[16vw] lg:text-[min(13rem,15vw)] font-black leading-[0.8] tracking-tighter text-white px-2 cursor-default">
                                <span class="inline-block transition-all duration-500 hover:blur-[25px] hover:opacity-30">FELIX</span> <br/>
                                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-500 to-white/90 italic pr-8 inline-block transition-all duration-500 hover:blur-[25px] hover:opacity-60">CORCORAN</span>
                            </h1>

                            <div class="mt-[2.5svh] md:mt-8 flex flex-col md:flex-row md:items-end gap-6">
                                <!-- Sin minúsculas forzadas: «IA» / «AI» se leen como siglas -->
                                <p class="text-[clamp(1.5rem,4.2svh,1.875rem)] md:text-5xl font-extralight text-neutral-400 leading-none tracking-tighter">
                                    {lang === 'es' ? (
                                        <>{t('hero.title.1')}{' '}<span class="text-white italic">{t('hero.title.2')}</span> & <br class="hidden md:block"/> {t('hero.title.3')}{' '}<span class="text-blue-500 font-normal">{t('hero.title.4')}</span>.</>
                                    ) : (
                                        <><span class="text-white italic">{t('hero.title.1')}</span> {t('hero.title.2')} & <br class="hidden md:block"/> <span class="text-blue-500 font-normal">{t('hero.title.3')}</span> {t('hero.title.4')}.</>
                                    )}
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-[3svh] md:gap-12 mt-0 md:mt-10">
                            <div class="lg:col-span-7">
                                <p class="text-[clamp(1rem,2.5svh,1.25rem)] md:text-2xl font-light text-neutral-300 leading-snug">
                                    {t('hero.degree')} <span class="text-white font-medium underline decoration-blue-500/30 underline-offset-8">{t('hero.degree.short')}</span>.
                                    {t('hero.desc')}
                                </p>
                            </div>
                            
                            <div class="lg:col-span-5 flex flex-col justify-end gap-[2.5svh] md:gap-10">
                                <a href="#proyectos" class="group relative flex items-end gap-4 px-2">
                                    <div class="relative overflow-hidden pr-6"> 
                                        <span class="block text-[clamp(1.75rem,5svh,2.25rem)] md:text-5xl font-black uppercase tracking-tighter text-white transition-transform duration-500 group-hover:-translate-y-full">{t('btn.projects')}</span>
                                        <span class="absolute top-0 left-0 block text-[clamp(1.75rem,5svh,2.25rem)] md:text-5xl font-black uppercase tracking-tighter text-blue-500 italic transition-transform duration-500 translate-y-full group-hover:translate-y-0">{t('btn.projects')}</span>
                                    </div>
                                    <div class="mb-2 h-px w-0 bg-neutral-500 transition-all duration-500 group-hover:w-12 opacity-50 group-hover:opacity-100"></div>
                                </a>

                                <!-- El currículum en el idioma de la página: se descarga directamente -->
                                <a href={lang === 'en' ? '/resume-felix-corcoran.pdf' : '/cv-felix-corcoran.pdf'} download={lang === 'en' ? 'Resume-Felix-Corcoran.pdf' : 'CV-Felix-Corcoran.pdf'} class="group relative flex items-end gap-4">
                                    <div class="relative overflow-hidden">
                                        <span class="block text-[clamp(1.75rem,5svh,2.25rem)] md:text-5xl font-black uppercase tracking-tighter text-neutral-300 transition-transform duration-500 group-hover:-translate-y-full">{t('btn.cv')}</span>
                                        <span class="absolute top-0 left-0 block text-[clamp(1.75rem,5svh,2.25rem)] md:text-5xl font-black uppercase tracking-tighter text-indigo-400 transition-transform duration-500 translate-y-full group-hover:translate-y-0">{t('btn.download')}</span>
                                    </div>
                                    <div class="mb-3 flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-blue-400 opacity-0 group-hover:opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400 group-hover:bg-blue-500 transition-colors duration-500"></span>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <!-- Contacto directo desde la portada: entran de uno en uno desde la izquierda -->
                        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 font-mono text-[11px] tracking-[0.25em] uppercase">
                            {[
                                { label: 'LinkedIn', href: persona.links.linkedin },
                                { label: 'GitHub', href: persona.links.github },
                                { label: persona.email, href: `mailto:${persona.email}` },
                            ].map((link, i) => (
                                <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="hero-link group inline-flex items-center gap-2 text-white/75 hover:text-white transition-colors" style={`--i: ${i}`}>
                                    <span class="relative">
                                        {link.label}
                                        <span class="absolute left-0 -bottom-1 h-px w-full origin-left scale-x-0 bg-blue-400 transition-transform duration-500 group-hover:scale-x-100"></span>
                                    </span>
                                    <span class="text-blue-400 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
                                </a>
                            ))}
                        </div>

                        <div class="hidden md:flex mt-0 md:mt-12 pt-0 md:pt-10 border-t border-white/5 flex-wrap gap-x-12 gap-y-2 md:gap-y-6 opacity-50">
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">n8n / AI APIs</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">PHP / Laravel</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">Astro / React</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">MySQL / REST API</span>
                        </div>
                    </div>
                </div>
            </section>

            <section id="proyectos" class="pt-20 md:pt-32 pb-16 md:pb-24 px-6 bg-[#050505]">
                <div class="max-w-7xl mx-auto">
                    <div class="flex flex-col mb-12 md:mb-24 space-y-4">
                        <!-- «MIS» sube al llegar; el contorno de «TRABAJOS» se rellena con el
                             degradado de «CORCORAN» a medida que se hace scroll (script) -->
                        <h2 id="projects-title" data-reveal class="text-[clamp(2.75rem,15vw,4.2rem)] md:text-[8rem] font-black text-white tracking-tighter uppercase italic leading-none">
                            <span class="block overflow-hidden pr-4">
                                <span class="rv-up block">{t('projects.section.title')}</span>
                            </span>
                            <span class="relative block pr-4">
                                <span class="block text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.4);">{t('projects.section.subtitle')}</span>
                                <span id="projects-fill" class="absolute inset-0 block pr-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-500 to-white/90" style="clip-path: inset(0 100% 0 0);" aria-hidden="true">{t('projects.section.subtitle')}</span>
                            </span>
                        </h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

                        <!-- En móvil, los proyectos propios en un carrusel que se desliza con el
                             dedo (scroll-snap nativo): una tarjeta entera y asoma la siguiente. En
                             escritorio el contenedor desaparece (display: contents) y las tarjetas
                             vuelven a la rejilla -->
                        <p class="md:hidden -mb-2 text-[10px] font-bold text-blue-400 uppercase tracking-widest">{t('projects.own.label')}</p>
                        <div class="carrusel md:contents" data-carrusel="propios">

                        <!-- Los proyectos (de perfil.ts), a la mitad y con la misma tarjeta. Sin
                             enlace (p. ej. el radar, repositorio privado): sin capa al pasar el ratón.
                             Con repositorio público, la tarjeta lleva la web en una capa que la cubre
                             entera y el enlace «Código» encima (un enlace no puede ir dentro de otro) -->
                        {halfCards.map((project, i) => {
                            const Card = project.url && !project.repo ? 'a' : 'div';
                            return (
                            <Card {...(Card === 'a' ? { href: project.url, target: '_blank', rel: 'noopener' } : {})} data-reveal class:list={['carrusel-item project-card md:col-span-6 group relative overflow-hidden bg-neutral-900/40 border border-white/5 rounded-[2.5rem] flex flex-col transition-colors duration-700', project.url && 'hover:border-blue-500/50']}>
                                {project.url && project.repo && (
                                    <a href={project.url} target="_blank" rel="noopener" class="absolute inset-0 z-20 rounded-[2.5rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400" aria-label={`${project.action}: ${project.name.replace('\u200b', '')}`}></a>
                                )}
                                <!-- El código, en la esquina de la captura y por encima de la capa del enlace -->
                                {project.repo && (
                                    <a href={project.repo} target="_blank" rel="noopener" class="absolute top-5 right-5 z-30 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/15 bg-black/60 backdrop-blur-md text-[10px] text-blue-200 uppercase font-bold transition-colors hover:border-blue-300/60 hover:bg-blue-500/20 hover:text-white">
                                        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.8-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg>
                                        {t('btn.code')} ↗
                                    </a>
                                )}
                                {project.image && (
                                    <div class="rv-wipe relative aspect-[16/10] overflow-hidden border-b border-white/5" style={`--i: ${i % 2}`}>
                                        <Image src={project.image} alt={project.name.replace('\u200b', '')} widths={[600, 900, 1200]} sizes="(min-width: 768px) 50vw, 86vw" loading="eager" class="h-full w-full object-cover object-top transition-transform duration-[1400ms] ease-out group-hover:scale-[1.06]" />
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/0 to-black/0 opacity-60 transition-opacity duration-500 group-hover:opacity-100"></div>
                                        {project.url && (
                                            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 md:p-8 translate-y-full transition-transform duration-500 ease-out group-hover:translate-y-0">
                                                <span class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white leading-none">{project.action}</span>
                                                <span class="font-mono text-[11px] uppercase tracking-[0.3em] text-blue-300">{project.hover} ↗</span>
                                            </div>
                                        )}
                                    </div>
                                )}
                                <div class="rv-fade relative z-10 p-6 md:p-12 flex flex-1 flex-col justify-between gap-6 md:gap-8" style={`--i: ${(i % 2) + 2}`}>
                                    <div>
                                        <div class="flex flex-wrap items-center gap-3 mb-5">
                                            <span class="text-[11px] font-bold text-blue-400 uppercase tracking-widest">{project.tag}</span>
                                            {project.status && <span class="px-2.5 py-1 rounded-full border border-white/20 text-[10px] text-white/70 uppercase font-bold tracking-widest">{project.status}</span>}
                                        </div>
                                        <h3 class="text-[clamp(1.75rem,6vw,3rem)] md:text-[clamp(1.75rem,3.2vw,3rem)] font-black text-white tracking-tighter uppercase mb-5 leading-[0.9]">{project.name}</h3>
                                        <p class="text-neutral-300 text-base md:text-lg leading-relaxed">
                                            {project.desc}
                                        </p>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {project.chips.map((chip) => (
                                            <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-white/75 uppercase font-bold">{chip}</span>
                                        ))}
                                    </div>
                                </div>
                                <!-- La marca de agua va en ::before: es decoración, no texto -->
                                <span data-mark={project.mark} class="absolute -bottom-10 -right-6 text-[16rem] font-black text-white/[0.02] select-none pointer-events-none before:content-[attr(data-mark)]" aria-hidden="true"></span>
                            </Card>
                            );
                        })}

                        <!-- Tarjetas anchas (wide en perfil.ts): bajas y discretas, al final (con first, arriba del todo). Spain
                             Trading Cards aún no es pública: lleva al caso contado en felixcorcoran.es -->
                        {wideCards.map((project) => {
                            // Como en las de la mitad: con repositorio, la web va en una capa y «Código» encima
                            const Card = project.repo ? 'div' : 'a';
                            return (
                        <Card {...(Card === 'a' ? { href: project.url, target: '_blank', rel: 'noopener' } : {})} data-reveal class:list={['carrusel-item md:col-span-12 group relative overflow-hidden bg-neutral-900/30 border border-white/5 rounded-[2.5rem] grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] transition-colors duration-700 hover:border-blue-500/50', project.first && 'order-first', project.client && 'max-md:hidden']}>
                            {project.repo && (
                                <>
                                    <a href={project.url} target="_blank" rel="noopener" class="absolute inset-0 z-20 rounded-[2.5rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400" aria-label={`${project.action}: ${project.name}`}></a>
                                    <a href={project.repo} target="_blank" rel="noopener" class="absolute top-5 right-5 z-30 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/15 bg-black/60 backdrop-blur-md text-[10px] text-blue-200 uppercase font-bold transition-colors hover:border-blue-300/60 hover:bg-blue-500/20 hover:text-white">
                                        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.8-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg>
                                        {t('btn.code')} ↗
                                    </a>
                                </>
                            )}
                            <div class="rv-fade p-6 md:p-12 flex flex-col justify-center gap-5 md:gap-6 order-2 lg:order-1" style="--i: 2">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span class="text-[11px] font-bold text-blue-400 uppercase tracking-widest">{project.tag}</span>
                                    {project.status && <span class="px-2.5 py-1 rounded-full border border-amber-400/40 text-[10px] text-amber-300/90 uppercase font-bold tracking-widest">{project.status}</span>}
                                </div>
                                <h3 class="text-3xl md:text-5xl font-black text-white tracking-tighter uppercase leading-[0.9]">{project.name}</h3>
                                <p class="text-neutral-300 text-base md:text-lg leading-relaxed">
                                    {project.desc}
                                </p>
                                <div class="flex flex-wrap gap-2">
                                    {project.chips.map((tech) => (
                                        <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-white/75 uppercase font-bold">{tech}</span>
                                    ))}
                                </div>
                                <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.3em] text-blue-300">
                                    {project.action}
                                    <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
                                </span>
                            </div>
                            {project.image && (
                                <div class="rv-wipe-x relative max-md:aspect-[16/10] md:min-h-[16rem] overflow-hidden order-1 lg:order-2 border-b lg:border-b-0 lg:border-l border-white/5">
                                    <Image src={project.image} alt={project.name} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 50vw, 86vw" loading="eager" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.05]" style={`object-position: ${project.imagePos}`} />
                                    <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"></div>
                                </div>
                            )}
                        </Card>
                            );
                        })}
                        </div>
                        <div class="carrusel-puntos md:hidden" data-puntos="propios" aria-hidden="true"></div>

                        <!-- Un foco de luz azul sigue al ratón por todo el panel (script) -->
                        <div id="gallery" class="relative isolate overflow-hidden md:col-span-12 p-5 pt-10 sm:p-10 md:p-20 bg-neutral-900/20 border border-white/5 rounded-[3rem]">
                            <div class="gallery-glow" aria-hidden="true"></div>
                            
                            <!-- Cabecera: la etiqueta sube, las letras del titular caen girando
                                 como un panel de aeropuerto, el subtítulo aparece y la línea se dibuja -->
                            <div data-reveal class="relative flex flex-col md:flex-row md:items-end justify-between mb-10 pb-6 md:mb-20 md:pb-10">
                                <div>
                                    <span class="block overflow-hidden mb-4">
                                        <span class="rv-up block text-[10px] font-bold text-blue-400 uppercase tracking-widest">
                                            {t('projects.freelance.label')}
                                        </span>
                                    </span>
                                    <h3 class="rv-flap-box text-[clamp(2rem,10vw,3rem)] md:text-6xl leading-[0.95] font-black text-white uppercase tracking-tighter" aria-label={t('projects.freelance.title')}>
                                        {letters(t('projects.freelance.title')).map((word, w, all) => (
                                            <><span class="inline-block whitespace-nowrap" aria-hidden="true">{word.map((ch, k) => (
                                                <span class="rv-flap inline-block" style={`--k: ${all.slice(0, w).flat().length + k}`}>{ch}</span>
                                            ))}</span>{' '}</>
                                        ))}
                                    </h3>
                                </div>
                                <p class="rv-fade text-neutral-300 font-mono text-xs uppercase tracking-widest italic mb-2" style="--i: 4">
                                    {t('projects.freelance.sub')}
                                </p>
                                <span class="rv-line absolute left-0 right-0 bottom-0 h-px bg-gradient-to-r from-blue-400/60 via-indigo-500/30 to-white/5" aria-hidden="true"></span>
                            </div>

                            <!-- Las tarjetas entran escalonadas al llegar a la galería. En móvil,
                                 carrusel; delante, los trabajos para clientes que en escritorio van
                                 con los proyectos (Spain Trading Cards) -->
                            <div class="carrusel carrusel--galeria sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-carrusel="clientes">
                                {clientCards.map((project) => (
                                    <a
                                        href={project.url}
                                        target="_blank"
                                        rel="noopener"
                                        data-reveal
                                        class="carrusel-item md:hidden rv-card group relative rounded-[2rem] overflow-hidden border border-white/5 bg-[#080808]/80 block isolate"
                                    >
                                        {project.image && (
                                            <div class="relative aspect-[16/10] overflow-hidden">
                                                <Image src={project.image} alt={project.name} widths={[400, 700]} sizes="(min-width: 640px) 45vw, 86vw" loading="eager" class="h-full w-full object-cover" style={`object-position: ${project.imagePos}`} />
                                                <div class="absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-[#080808] to-transparent"></div>
                                            </div>
                                        )}
                                        <div class="relative p-6">
                                            <div class="flex flex-wrap items-center gap-3 mb-3">
                                                <span class="text-[10px] font-bold text-blue-400 uppercase tracking-[0.35em]">{project.tag}</span>
                                                {project.status && <span class="px-2.5 py-1 rounded-full border border-amber-400/40 text-[10px] text-amber-300/90 uppercase font-bold tracking-widest">{project.status}</span>}
                                            </div>
                                            <h4 class="text-xl sm:text-2xl font-black uppercase tracking-tighter text-white leading-[0.95]">{project.name}</h4>
                                            <p class="mt-3 line-clamp-2 text-neutral-300 text-sm leading-relaxed">{project.desc}</p>
                                            <span class="mt-3 inline-block text-white/70 text-[11px] uppercase tracking-[0.3em] font-mono">{project.action} ↗</span>
                                        </div>
                                    </a>
                                ))}
                                {clientSites.map((site, index) => (
                                    <a
                                        href={site.url}
                                        target="_blank"
                                        rel="noopener"
                                        data-reveal
                                        class="carrusel-item rv-card group relative rounded-[2rem] overflow-hidden border border-white/5 bg-[#080808]/80 block isolate transition-colors duration-700 hover:border-blue-500/40"
                                        style={`--i: ${index % 3}`}
                                    >
                                        <div class="relative aspect-[16/10] overflow-hidden">
                                            <Image src={site.image} alt={site.name} widths={[400, 700]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 86vw" loading="eager" class="h-full w-full object-cover object-top transition-transform duration-[1200ms] ease-out group-hover:scale-[1.07]" />
                                            <div class="absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-[#080808] to-transparent"></div>
                                        </div>
                                        <div class="absolute top-0 left-[-100%] w-full h-px bg-gradient-to-r from-transparent via-blue-400 to-transparent group-hover:left-full transition-all duration-1000"></div>
                                        <div class="relative p-6 flex items-end justify-between gap-4">
                                            <div class="min-w-0">
                                                <span class="block mb-3 text-[10px] font-bold text-blue-400 uppercase tracking-[0.35em]">{site.cat}</span>
                                                <h4 class="text-xl sm:text-2xl font-black uppercase tracking-tighter text-white leading-[0.95] hyphens-auto [overflow-wrap:anywhere] transition-colors duration-500 group-hover:text-blue-100">{site.name}</h4>
                                                <p class="mt-3 line-clamp-2 text-neutral-300 text-sm leading-relaxed">{site.desc}</p>
                                                <span class="mt-3 inline-block text-white/70 text-[11px] uppercase tracking-[0.3em] font-mono transition-colors duration-500 group-hover:text-blue-300">{t('btn.visit')}</span>
                                            </div>
                                            <div class="relative shrink-0 w-12 h-12 rounded-full border border-white/10 bg-white/[0.03] overflow-hidden flex items-center justify-center transition-all duration-700 group-hover:border-blue-400/50 group-hover:rotate-12 group-hover:scale-110">
                                                <span class="text-white/70 text-lg transition-all duration-700 group-hover:translate-x-8 group-hover:-translate-y-8 group-hover:opacity-0">↗</span>
                                                <span class="absolute text-blue-300 text-lg translate-x-[-30px] translate-y-[30px] opacity-0 transition-all duration-700 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100">↗</span>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                            <div class="carrusel-puntos sm:hidden" data-puntos="clientes" aria-hidden="true"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Experiencia: lo mismo que el currículum. Una línea de tiempo que se dibuja con el
                 scroll; cada puesto entra al llegar y reacciona al pasar el ratón -->
            <section id="experiencia" class="relative pt-24 pb-12 md:pt-32 md:pb-16 px-6 bg-black border-t border-white/5 overflow-hidden">
                <div class="relative max-w-7xl mx-auto">
                    <!-- La etiqueta se escribe letra a letra con su cursor y la línea se alarga después -->
                    <div data-reveal class="flex items-center gap-6 text-blue-500 font-mono text-xs tracking-[0.3em] uppercase mb-12 md:mb-16">
                        <span class="rv-type"><span class="sr-only">{t('exp.label')}</span>{[...t('exp.label')].map((ch, k) => (
                            <span class="rv-key" style={`--k: ${k}`} aria-hidden="true">{ch}</span>
                        ))}<span class="rv-caret" aria-hidden="true"></span></span>
                        <div class="rv-grow h-px flex-1 bg-blue-500/20" style={`--k: ${t('exp.label').length}`}></div>
                    </div>

                    <h2 id="exp-title" class="text-[clamp(2.25rem,11vw,8rem)] font-black text-white tracking-tighter uppercase leading-none mb-16 md:mb-24">
                        <!-- Cada letra sube de su máscara y se endereza a medida que haces scroll (script) -->
                        <span class="block overflow-hidden pb-[0.06em]"><span class="sr-only">{t('exp.title')}</span>
                            <span class="block whitespace-nowrap" aria-hidden="true">{[...t('exp.title')].map((ch) => (
                                <span class="exp-letter inline-block">{ch}</span>
                            ))}</span>
                        </span>
                    </h2>

                    <ol id="exp-list" class="relative pl-8 md:pl-16">
                        <!-- La línea de tiempo: el relleno crece con el scroll (script) -->
                        <span class="absolute left-0 top-0 bottom-0 w-px bg-white/10" aria-hidden="true">
                            <span id="exp-progress" class="absolute inset-0 origin-top bg-gradient-to-b from-blue-400 via-indigo-500 to-indigo-500/0"></span>
                        </span>

                        {jobs.map((job) => (
                            <li class="exp-row group relative py-12 md:py-16">
                                <!-- El punto de la línea de tiempo: se enciende al llegar -->
                                <span class="exp-dot absolute -left-8 md:-left-16 top-[3.7rem] md:top-[4.7rem] -translate-x-1/2 w-3 h-3 rounded-full border border-white/30 bg-black transition-all duration-700" aria-hidden="true"></span>

                                <!-- Destello sobre la línea superior al pasar el ratón -->
                                <span class="absolute top-0 left-0 right-0 h-px bg-white/10 overflow-hidden" aria-hidden="true">
                                    <span class="absolute top-0 left-[-100%] w-full h-px bg-gradient-to-r from-transparent via-blue-400 to-transparent transition-all duration-1000 group-hover:left-full"></span>
                                </span>

                                <div class="relative grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-12">
                                    <div class="md:col-span-3 font-mono text-[11px] uppercase tracking-[0.3em] space-y-2 pt-2">
                                        <span class="block text-blue-400">{job.period}</span>
                                        <span class="block text-white/50 transition-colors duration-500 group-hover:text-white">{job.place}</span>
                                    </div>
                                    <div class="md:col-span-9 space-y-6">
                                        <!-- Al pasar el ratón, el degradado de «CORCORAN» recorre el cargo de izquierda a derecha -->
                                        <h3 class="role-wipe text-3xl md:text-4xl xl:text-5xl font-black tracking-tighter uppercase leading-[0.95] lg:whitespace-nowrap">{job.role}</h3>
                                        <p class="text-neutral-300 text-lg md:text-xl font-light leading-relaxed max-w-3xl transition-colors duration-500 group-hover:text-white">
                                            {job.desc}
                                        </p>
                                        <div class="flex flex-wrap gap-2">
                                            {job.tags.map((tag) => (
                                                <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-white/75 uppercase font-bold transition-colors duration-500 group-hover:border-blue-400/30 group-hover:text-blue-200/80">{tag}</span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </li>
                        ))}
                    </ol>
                </div>
            </section>

            <!-- Stack en una pantalla. El titular entra de lado con el scroll (script);
                 los cuatro grupos giran hacia ti escalonados y sus iconos aparecen
                 de uno en uno -->
            <section id="tech" class="pt-24 pb-16 md:pt-32 md:pb-20 px-6 bg-black overflow-hidden border-t border-white/5">
                <div class="max-w-7xl mx-auto">

                    <div class="flex flex-col lg:flex-row gap-6 lg:items-end mb-14 md:mb-20 border-b border-white/5 pb-10">
                        <h2 id="stack-title" class="text-[22vw] lg:text-[9vw] font-black leading-[0.7] tracking-tighter text-white">
                            STACK
                        </h2>
                        <div class="flex-1 lg:pl-10">
                            <p class="text-lg md:text-2xl font-extralight text-neutral-300 max-w-md leading-none lowercase tracking-tighter italic">
                                {t('stack.tagline.1')} <br/> {t('stack.tagline.2')}
                            </p>
                        </div>
                    </div>

                    <div class="stack-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
                        {stackGroups.map((g, i) => (
                            <article data-reveal class="rv-flip group relative flex flex-col gap-5 rounded-[2rem] border border-white/5 bg-neutral-900/40 p-7 transition-colors duration-500 hover:border-blue-500/40" style={`--i: ${i}`}>
                                <div class="flex items-center gap-3 font-mono text-[11px] tracking-[0.3em] uppercase text-blue-400">
                                    <span>0{i + 1}</span>
                                    <span class="h-px flex-1 origin-left bg-blue-500/25 transition-transform duration-700 group-hover:scale-x-110"></span>
                                </div>
                                <h3 class="text-2xl md:text-3xl xl:text-2xl font-black uppercase tracking-tighter text-white leading-none hyphens-auto">{g.label}</h3>
                                <p class="text-neutral-300 text-[15px] leading-relaxed">{g.text}</p>
                                <!-- Filas de cinco casillas; el nombre sale en una etiqueta propia al pasar el ratón -->
                                <ul class="mt-auto grid grid-cols-5 gap-2.5 pt-2">
                                    {g.items.map((item, j) => (
                                        <li class="tech rv-pop" data-col={col(g, j)} style={`--i: ${i}; --j: ${j}; --c: ${item.icon?.color ?? '#93c5fd'}; grid-column-start: ${col(g, j)}`}>
                                            {item.icon ? (
                                                <svg viewBox="0 0 24 24" role="img" aria-label={item.name}><path d={item.icon.path} /></svg>
                                            ) : (
                                                <span class="tech-abbr" role="img" aria-label={item.name}>{item.name}</span>
                                            )}
                                            <span class="tech-tip" aria-hidden="true">{item.name}</span>
                                        </li>
                                    ))}
                                </ul>
                            </article>
                        ))}
                    </div>

                    <div data-reveal class="mt-10 flex flex-wrap items-center gap-4 font-mono text-[11px] tracking-[0.25em] uppercase text-white/70">
                        <span class="rv-fade" style="--i: 1">{t('stack.learning')}</span>
                        {learningIcons.map((item, j) => (
                            <span class="rv-fade inline-flex items-center gap-3 text-white/85" style={`--i: ${j + 2}`}>
                                <span class="tech tech-sm" style={`--c: ${item.icon?.color ?? '#93c5fd'}`}>
                                    {item.icon && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon.path} /></svg>}
                                </span>
                                {item.name}
                            </span>
                        ))}
                    </div>
                </div>
            </section>

            <section id="contacto" class="max-md:min-h-svh max-md:flex max-md:flex-col max-md:justify-center py-[4svh] [@media(max-height:700px)]:py-[2.5svh] md:py-32 px-6 bg-black border-t border-white/5">
                <div class="max-w-7xl mx-auto max-md:w-full">
                    
                    <div class="flex items-center gap-6 text-indigo-500 font-mono text-xs tracking-[0.3em] uppercase mb-[3svh] md:mb-24">
                        <div class="h-px flex-1 bg-indigo-500/20"></div>
                        <span>{t('contact.label')}</span>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-[3svh] md:gap-16 lg:gap-24">
                        
                        <!-- El tamaño del titular sale del ancho de su columna (cqw), nunca se sale -->
                        <div class="space-y-[2.5svh] md:space-y-12 [container-type:inline-size]">
                            <h3 id="contact-title" data-reveal class="text-[min(14.5cqw,8svh)] md:text-[clamp(2.25rem,14.5cqw,6rem)] font-black text-white leading-[0.9] uppercase tracking-tighter" aria-label={`${t('contact.title.1')} ${t('contact.title.2')}`}>
                                <span class="block whitespace-nowrap" aria-hidden="true">{[...t('contact.title.1')].map((ch, k) => (
                                    <span class="rv-wave inline-block" style={`--k: ${k}`}>{ch}</span>
                                ))}</span>
                                <span class="block overflow-hidden pt-[0.14em] pr-[0.1em] -mt-[0.14em]" aria-hidden="true">
                                    <span class="rv-skew contact-outline block italic" style={`--k: ${[...t('contact.title.1')].length}`}>{t('contact.title.2')}</span>
                                </span>
                            </h3>
                            
                            <div class="space-y-[2svh] md:space-y-8">
                                <p class="text-neutral-300 text-[clamp(0.85rem,2.3svh,1.15rem)] md:text-xl font-light leading-snug md:leading-relaxed md:max-w-sm">
                                    {t('contact.available')}
                                </p>
                                
                                <div data-reveal class="space-y-[1.2svh] md:space-y-4 font-mono text-[10px] tracking-[0.2em] uppercase">
                                    <div class="rv-fade flex justify-between border-b border-white/5 pb-1 md:pb-2" style="--i: 1">
                                        <span class="text-white/70">{t('contact.meta.email')}</span>
                                        <a href={`mailto:${persona.email}`} class="text-indigo-400 hover:text-white transition normal-case tracking-[0.1em]">{persona.email}</a>
                                    </div>
                                    <div class="rv-fade flex justify-between border-b border-white/5 pb-1 md:pb-2" style="--i: 2">
                                        <span class="text-white/70">{t('contact.meta.location')}</span>
                                        <span class="text-white/60">{t('contact.location')}</span>
                                    </div>
                                    <div class="rv-fade flex justify-between" style="--i: 3">
                                        <span class="text-white/70">{t('contact.meta.status')}</span>
                                        <span class="text-green-500 flex items-center gap-2">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                                            {t('contact.status')}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Los mensajes de estado del envío, en el idioma de la página (los lee el script) -->
                        <form
                            action="/api/send-email"
                            method="POST"
                            id="contact-form"
                            data-reveal
                            class="space-y-1"
                            data-send={t('contact.send')}
                            data-sending={t('contact.sending')}
                            data-sent={t('contact.sent')}
                            data-error={t('contact.error')}
                            data-failed={t('contact.failed')}
                        >
                            {['name', 'email', 'project'].map((key, i) => {
                                const label = t(`contact.label.${key}`);
                                const placeholder = t(`contact.placeholder.${key}`);
                                return (
                                    <div class="rv-fade group relative border-b border-white/10 focus-within:border-indigo-500 transition-colors duration-500" style={`--i: ${i + 1}`}>
                                        <!-- Al escribir, una línea con degradado se dibuja bajo el campo -->
                                        <span class="pointer-events-none absolute left-0 right-0 -bottom-px h-px origin-left scale-x-0 bg-gradient-to-r from-blue-400 via-indigo-500 to-transparent transition-transform duration-700 group-focus-within:scale-x-100" aria-hidden="true"></span>
                                        <label class="block text-[10px] font-mono text-white/80 uppercase tracking-[0.3em] pt-[1.8svh] md:pt-8 pb-1 md:pb-2 transition-all duration-500 group-focus-within:text-indigo-500 group-focus-within:translate-x-2">
                                            {label}
                                        </label>
                                        
                                        {key === 'project' ? (
                                            <textarea 
                                                name="proyecto" 
                                                rows="4" 
                                                required
                                                class="w-full bg-transparent max-md:h-[10svh] [@media(max-height:700px)]:h-11 py-[1.2svh] md:py-4 text-white font-mono text-sm outline-none resize-none placeholder:text-white/20" 
                                                placeholder={placeholder}
                                            ></textarea>
                                        ) : (
                                            <input 
                                                name={key === 'email' ? 'correo' : 'nombre'}
