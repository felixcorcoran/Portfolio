    .tech[data-col="5"]:hover .tech-tip { transform: none; }
    .tech[data-col="5"] .tech-tip::after { left: auto; right: 1.25rem; margin-left: 0; margin-right: -5px; }

    .anim [data-reveal]:not(.is-in) :is(.rv-wipe, .rv-wipe-x) { clip-path: inset(100% 0 0 0); }
    .anim [data-reveal]:not(.is-in) :is(.rv-pop, .rv-track),
    .anim .rv-flip[data-reveal]:not(.is-in) { opacity: 0; }

    .anim .is-in .rv-wipe { animation: rv-wipe 1.1s cubic-bezier(0.77, 0, 0.175, 1) calc(var(--i, 0) * 120ms) both; }
    .anim .is-in .rv-wipe img { animation: rv-wipe-img 1.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 120ms) both; }
    .anim .is-in .rv-wipe-x { animation: rv-wipe-x 1.2s cubic-bezier(0.77, 0, 0.175, 1) 0.1s both; }
    .anim .is-in .rv-wipe-x img { animation: rv-wipe-img 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
    .anim .rv-flip.is-in { animation: rv-flip 1s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 130ms) both; transform-origin: left center; }
    .anim .is-in .rv-pop { animation: rv-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.35s + var(--i, 0) * 130ms + var(--j, 0) * 45ms) both; }
    .anim .is-in .rv-track { animation: rv-track 1.2s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 150ms) both; }

    /* En una columna cada tarjeta entra sola al llegar: sin esperar a sus vecinas */
    @media (max-width: 639px) {
        .rv-card, .rv-flip, .rv-flip .rv-pop { --i: 0 !important; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-link { animation: none; }
        .exp-anim .exp-row { opacity: 1; transform: none; filter: none; transition: none; }
        #exp-progress { transform: none; }
    }

    /* Carruseles de móvil (proyectos propios y clientes): deslizamiento nativo
       con scroll-snap, una tarjeta entera y asoma el borde de la siguiente. Solo
       por debajo de su punto de corte: en escritorio, la rejilla de siempre */
    @media (max-width: 47.99rem) {
        .carrusel:not(.carrusel--galeria) { --sangria: 1.5rem; }
    }
    @media (max-width: 39.99rem) {
        .carrusel--galeria { --sangria: 1.25rem; }
    }
    @media (max-width: 47.99rem) {
        .carrusel:not(.carrusel--galeria),
        .carrusel--galeria {
            display: flex;
            align-items: stretch;
            gap: 1rem;
            overflow-x: auto;
            overscroll-behavior-x: contain;
            scroll-snap-type: x mandatory;
            scroll-padding-inline: var(--sangria, 1.25rem);
            margin-inline: calc(-1 * var(--sangria, 1.25rem));
            padding: 0.25rem var(--sangria, 1.25rem) 0.5rem;
            scrollbar-width: none;
        }
        .carrusel::-webkit-scrollbar { display: none; }
        /* Tarjetas más bajas: descripción recortada y menos relleno */
        .carrusel > .project-card p.leading-relaxed { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.9375rem; }
        .carrusel > .project-card > div:last-of-type { padding: 1.25rem; }
        .carrusel > .carrusel-item > div:last-child:not(.rv-wipe) { padding: 1.25rem; }
        .carrusel > .carrusel-item {
            flex: 0 0 78%;
            min-width: 0;
            scroll-snap-align: start;
        }
    }
    @media (min-width: 40rem) and (max-width: 47.99rem) {
        /* La galería ya es rejilla de dos desde sm */
        .carrusel--galeria {
            display: grid;
            gap: 1.5rem;
            overflow: visible;
            margin-inline: 0;
            padding: 0;
        }
    }

    /* Debajo de cada carrusel: «2 de 5» y un punto por tarjeta */
    .carrusel-puntos {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        margin-top: 0.25rem;
        font: 600 10px/1 ui-monospace, monospace;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.5);
    }
    .carrusel-puntos:empty { display: none; }
    .carrusel-puntos .cuenta { margin-right: 0.6rem; }
    .carrusel-puntos i {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: rgb(255 255 255 / 0.2);
        transition: width 0.3s ease, background-color 0.3s ease;
    }
    .carrusel-puntos i.activo {
        width: 18px;
        background: rgb(96 165 250);
    }
</style>

<script>
    const stackTitle = document.querySelector('#stack-title') as HTMLElement;

    const handleScroll = () => {
        if (stackTitle) {
            const rectStack = stackTitle.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const scrollPercentStack = Math.min(Math.max((windowHeight - rectStack.top) / (windowHeight * 0.9), 0), 1);
            stackTitle.style.transform = `translateX(${(1 - scrollPercentStack) * -80}%)`;
            stackTitle.style.opacity = scrollPercentStack.toString();
        }
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll();

    // El botón ES/EN se aparta al bajar (para no taparse con los titulares) y
    // vuelve al subir o al llegar arriba
    const langNav = document.getElementById('lang-nav');
    let lastY = scrollY;
    window.addEventListener('scroll', () => {
        if (!langNav) return;
        const y = scrollY;
        if (y > 240 && y > lastY + 4) langNav.style.transform = 'translateY(-160%)';
        else if (y < lastY - 4 || y < 240) langNav.style.transform = '';
        lastY = y;
    }, { passive: true });
    langNav?.addEventListener('focusin', () => (langNav.style.transform = ''));

    // ---------- Experiencia ----------
    // La línea de tiempo se rellena con el scroll (de que la lista asoma por
    // abajo a que su final pasa por el centro de la pantalla) y enciende el
    // punto de cada puesto al llegar a él. Los puestos entran escalonados.
    const expSection = document.getElementById('experiencia');
    const expList = document.getElementById('exp-list');
    const expProgress = document.getElementById('exp-progress');
    const expRows = Array.from(document.querySelectorAll<HTMLElement>('.exp-row'));
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (expSection && expList && expProgress) {
        expSection.classList.add('exp-anim');

        const updateTimeline = () => {
            const rect = expList.getBoundingClientRect();
            const progress = reduceMotion
                ? 1
                : Math.min(Math.max((innerHeight * 0.75 - rect.top) / rect.height, 0), 1);
            expProgress.style.transform = `scaleY(${progress})`;
            const reached = rect.top + rect.height * progress;
            for (const row of expRows) {
                const dot = row.querySelector('.exp-dot') as HTMLElement | null;
                const dotY = dot ? dot.getBoundingClientRect().top : row.getBoundingClientRect().top;
                row.classList.toggle('is-on', dotY <= reached);
            }
        };

        const expObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const index = expRows.indexOf(el);
                el.style.transitionDelay = index > 0 ? `${index * 120}ms` : '';
                el.classList.add('is-in');
                expObserver.unobserve(el);
            });
        }, { threshold: 0.25 });

        expRows.forEach((row) => expObserver.observe(row));

        // El titular, letra a letra: cada una sube de su máscara y se endereza,
        // ligada al scroll (de que el titular asoma por abajo a que llega a
        // algo menos de media pantalla); al volver hacia arriba se deshace
        const expTitleBox = document.getElementById('exp-title');
        const expLetters = Array.from(document.querySelectorAll<HTMLElement>('.exp-letter'));
        const updateTitle = () => {
            if (!expTitleBox) return;
            const rect = expTitleBox.getBoundingClientRect();
            const p = reduceMotion ? 1 : Math.min(Math.max((innerHeight - rect.top) / (innerHeight * 0.55), 0), 1);
            const spread = 5;
            expLetters.forEach((letter, k) => {
                const lp = Math.min(Math.max(p * (expLetters.length + spread) - k, 0) / spread, 1);
                const e = 1 - Math.pow(1 - lp, 3);
                letter.style.transform = e === 1 ? '' : `translateY(${(1 - e) * 105}%) rotate(${(1 - e) * 12}deg)`;
                letter.style.opacity = String(0.15 + e * 0.85);
            });
        };
        window.addEventListener('scroll', updateTitle, { passive: true });
        window.addEventListener('resize', updateTitle);
        updateTitle();

        window.addEventListener('scroll', updateTimeline, { passive: true });
        window.addEventListener('resize', updateTimeline);
        updateTimeline();
    }

    // ---------- Entradas al llegar ([data-reveal], ver los estilos) ----------
    if (!reduceMotion) document.documentElement.classList.add('anim');
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
        });
    }, { threshold: 0.2 });
    document.querySelectorAll('[data-reveal]').forEach((el) => {
        // Los de un carrusel de móvil se descubren con el carrusel: los de más
        // allá del borde nunca llegarían a verse (y sus imágenes, a mostrarse)
        if (!el.closest('[data-carrusel]') || !matchMedia('(max-width: 47.99rem)').matches) revealObserver.observe(el);
    });
    document.querySelectorAll('[data-carrusel]').forEach((c) => {
        if (!matchMedia('(max-width: 47.99rem)').matches) return;
        const o = new IntersectionObserver((es) => {
            if (!es.some((e) => e.isIntersecting)) return;
            c.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
            o.disconnect();
        }, { threshold: 0.15 });
        o.observe(c);
    });

    // ---------- Carruseles de móvil: «2 de 5» y los puntos ----------
    document.querySelectorAll('[data-carrusel]').forEach((carrusel) => {
        const puntos = document.querySelector(`[data-puntos="${carrusel.dataset.carrusel}"]`);
        if (!puntos) return;
        // Las tarjetas que se ven (en móvil, Spain Trading Cards va solo en el de clientes)
        // En el orden en que se ven (el Radar va el último en el código y se pone delante con order)
        const items = () =>
            [...carrusel.children]
                .filter((el) => el.offsetParent !== null)
                .sort((a, b) => a.getBoundingClientRect().left - b.getBoundingClientRect().left);
        const de = puntos.closest('[lang]')?.lang === 'en' || document.documentElement.lang === 'en' ? 'of' : 'de';
        let actual = -1;
        const pintar = () => {
            const lista = items();
            if (getComputedStyle(carrusel).overflowX !== 'auto' || lista.length < 2) {
                puntos.replaceChildren();
                actual = -1;
                return;
            }
            // La tarjeta cuyo borde izquierdo está más cerca del de la caja
            const base = carrusel.getBoundingClientRect().left + parseFloat(getComputedStyle(carrusel).scrollPaddingLeft || '0');
            let i = 0;
            lista.forEach((el, k) => {
                if (Math.abs(el.getBoundingClientRect().left - base) < Math.abs(lista[i].getBoundingClientRect().left - base)) i = k;
            });
            if (i === actual && puntos.childElementCount) return;
            actual = i;
            const cuenta = document.createElement('span');
            cuenta.className = 'cuenta';
            cuenta.textContent = `${i + 1} ${de} ${lista.length}`;
            puntos.replaceChildren(cuenta, ...lista.map((_, k) => Object.assign(document.createElement('i'), { className: k === i ? 'activo' : '' })));
        };
        let pendiente = 0;
        const pedir = () => {
            if (pendiente) return;
            pendiente = requestAnimationFrame(() => {
                pendiente = 0;
                pintar();
            });
        };
        carrusel.addEventListener('scroll', pedir, { passive: true });
        addEventListener('resize', () => {
            actual = -1;
            pedir();
        });
        pintar();
    });

    // ---------- Galería: el foco sigue al ratón con algo de inercia ----------
    const gallery = document.getElementById('gallery');
    if (gallery && !reduceMotion && matchMedia('(hover: hover)').matches) {
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
        const step = () => {
            x += (tx - x) * 0.12;
            y += (ty - y) * 0.12;
            gallery.style.setProperty('--gx', `${x}px`);
            gallery.style.setProperty('--gy', `${y}px`);
            raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
        };
        gallery.addEventListener('pointermove', (e) => {
            const r = gallery.getBoundingClientRect();
            tx = e.clientX - r.left;
            ty = e.clientY - r.top;
            if (!gallery.classList.contains('is-lit')) {
                x = tx;
                y = ty;
                gallery.classList.add('is-lit');
            }
            if (!raf) raf = requestAnimationFrame(step);
        });
        gallery.addEventListener('pointerleave', () => gallery.classList.remove('is-lit'));
    }

    // ---------- «TRABAJOS»: el contorno se rellena con el scroll ----------
    // Empieza cuando el titular ya se ve entero y termina cuando llega arriba
    // de la pantalla (sin salirse)
    const projectsFill = document.getElementById('projects-fill');
    const projectsTitle = document.getElementById('projects-title');
    const updateFill = () => {
        if (!projectsFill) return;
        if (reduceMotion) {
            projectsFill.style.clipPath = 'none';
            return;
        }
        const rect = (projectsTitle ?? projectsFill).getBoundingClientRect();
        const start = innerHeight - rect.height;
        const end = innerHeight * 0.06;
        const progress = Math.min(Math.max((start - rect.top) / Math.max(start - end, 1), 0), 1);
        projectsFill.style.clipPath = `inset(0 ${(1 - progress) * 100}% 0 0)`;
    };
    window.addEventListener('scroll', updateFill, { passive: true });
    window.addEventListener('resize', updateFill);
    updateFill();

    const form = document.getElementById('contact-form');
    const btnText = document.getElementById('btn-text');
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.getElementById('submit-btn');

    // Textos del botón en el idioma de la página (data-* del formulario)
    const label = form.dataset;

    // El botón vuelve a estar disponible: tras un éxito (pasado un rato) o
    // tras un error (al momento, para poder reintentar)
    const enable = () => {
        submitBtn.style.pointerEvents = "auto";
        submitBtn.style.opacity = "1";
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        btnText.innerText = label.sending;
        submitBtn.style.pointerEvents = "none";
        submitBtn.style.opacity = "0.5";

        const formData = new FormData(form);

        try {
            const response = await fetch('/api/send-email', {
                method: 'POST',
                body: formData,
            });

            if (response.ok) {
                form.reset();
                btnText.innerText = label.sent;
                successMsg.classList.remove('hidden');
                setTimeout(() => {
                    successMsg.classList.add('hidden');
                    btnText.innerText = label.send;
                    enable();
                }, 5000);
            } else {
                btnText.innerText = label.error;
                enable();
            }
        } catch (error) {
            btnText.innerText = label.failed;
            enable();
        }
    });
</script>