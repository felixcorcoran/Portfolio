---
import '../styles/global.css';
import { useTranslations } from '../utils/i18n';
import { Image } from 'astro:assets';
import { persona, projects, experience, skills, learning, pick } from '../data/perfil';
import { skillIcon } from '../data/iconos';

const title = "Félix Corcoran | Full Stack & AI Automation";
const { lang = 'es' } = Astro.props; 
const t = useTranslations(lang);

// URLs absolutas para buscadores y redes: la página en cada idioma
const site = Astro.site ?? new URL('https://dev.felixcorcoran.es');
const urlEs = new URL('/', site).href;
const urlEn = new URL('/en/', site).href;
const canonical = lang === 'en' ? urlEn : urlEs;

// Stack, Experiencia y Mis trabajos salen de src/data/perfil.ts, lo mismo que
// el currículum: se actualiza allí y cambian las dos cosas
const group = (id) => skills.find((s) => s.id === id)?.items ?? [];
const withIcon = (items) => items.filter((name) => skillIcon[name]);
const aiTools = [...group('ai'), ...group('integrations')];

const jobs = experience.map((job) => ({
    role: job.role[lang],
    place: job.company || 'Freelance',
    period: job.period[lang],
    desc: job.highlights.map((h) => h[lang]).join(' '),
    tags: job.tags.map((tag) => pick(tag, lang)),
}));

// Capturas de los proyectos y de las webs de clientes (src/assets/projects/*.jpg)
const shots = import.meta.glob('../assets/projects/*.jpg', { eager: true, import: 'default' });
const shot = (key) => (key ? shots[`../assets/projects/${key}.jpg`] : undefined);

const actions = { visit: t('btn.visit'), explore: t('btn.explore'), case: t('btn.case') };
const cards = projects
    .filter((p) => p.web)
    .map((p) => ({
        // En pantallas muy estrechas, un dominio se parte antes de «.es», nunca a mitad de palabra
        name: pick(p.name, lang).replace(/\.(?=[a-z]+$)/, '\u200b.'),
        url: p.web.url?.[lang] ?? p.url ?? null,
        tag: p.web.tag[lang],
        status: p.status?.[lang],
        desc: [p.summary[lang], ...p.highlights.map((h) => h[lang])].join(' '),
        chips: p.stack,
        action: actions[p.web.action ?? 'visit'],
        hover: p.web.hover?.[lang],
        mark: p.web.mark,
        wide: p.web.wide ?? false,
        image: shot(p.web.image),
    }));
const halfCards = cards.filter((c) => !c.wide);
const wideCards = cards.filter((c) => c.wide);

// Stack en una pantalla: cuatro grupos (de perfil.ts) con su frase y sus iconos
const stackGroups = [
    { label: t('stack.backend'), text: t('stack.backend.text'), icons: withIcon(group('backend')) },
    { label: t('stack.frontend'), text: t('stack.frontend.text'), icons: withIcon(group('frontend')) },
    { label: t('stack.ai'), text: t('stack.ai.text'), chips: aiTools },
    { label: t('stack.tools'), text: t('stack.tools.text'), icons: withIcon(group('tools')) },
];
const learningIcons = learning.map((name) => ({ name, id: skillIcon[name] })).filter((tech) => tech.id);

// Galería freelance: cada web con su captura
const clientSites = [
    { name: 'MBH Builders', url: 'https://mbhbuilders.es/inicio.html', cat: { es: 'Construcción', en: 'Construction' }, image: 'mbh' },
    { name: 'Pilar Peluquería', url: 'https://pilarpeluqueria.com/inicio.html', cat: { es: 'Peluquería', en: 'Hair salon' }, image: 'pilar' },
    { name: 'Reformas Paola', url: 'https://reformasymantenimientospaola.com/inicio', cat: { es: 'Reformas', en: 'Renovations' }, image: 'paola' },
    { name: 'Ávila Secretaría Online', url: 'https://avilasecretariaonline.com/', cat: { es: 'Servicios', en: 'Services' }, image: 'avila' },
    { name: 'Susana Floria Nails', url: 'https://susanaflorianails.com/sobrenosotros.html', cat: { es: 'Estética', en: 'Beauty' }, image: 'susana' },
    { name: 'Construcciones Omega', url: 'https://construccionesyserviciosomega.com/inicio', cat: { es: 'Construcción', en: 'Construction' }, image: 'omega' },
].map((s) => ({ ...s, cat: s.cat[lang], image: shot(s.image) }));
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <!-- El monograma «fc» de la marca, en la paleta oscura e índigo del portfolio -->
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={t('seo.description')}>
        <title>{title}</title>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={urlEs} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlEs} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={t('seo.description')} />
        <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
        <meta property="og:image" content={new URL('/og.png', site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <!-- Cambio de idioma: si se llega desde el otro idioma, la página empieza
             oculta para aparecer ya en el punto donde se estaba (script del final) -->
        <script is:inline>
            try {
                if (sessionStorage.getItem('lang-switch')) {
                    document.documentElement.classList.add('lang-arriving');
                    history.scrollRestoration = 'manual';
                }
            } catch {}
        </script>
    </head>
    <body class="bg-neutral-950 text-white selection:bg-blue-500/30 font-sans">
        
        <nav id="lang-nav" class="fixed top-6 right-6 z-50 transition-transform duration-500 flex items-center gap-2 font-mono text-[10px] tracking-[0.3em] uppercase bg-neutral-900/40 backdrop-blur-md px-4 py-2 rounded-full border border-white/5">
            <a href="/" hreflang="es" data-lang-switch aria-current={lang === 'es' ? 'page' : undefined} class={lang === 'es' ? 'text-blue-400 font-bold' : 'text-neutral-400 hover:text-white transition-colors duration-300'}>ES</a>
            <span class="text-neutral-800">/</span>
            <a href="/en/" hreflang="en" data-lang-switch aria-current={lang === 'en' ? 'page' : undefined} class={lang === 'en' ? 'text-indigo-400 font-bold' : 'text-neutral-400 hover:text-white transition-colors duration-300'}>EN</a>
        </nav>
        
        <main>
            <section class="relative min-h-screen flex items-center justify-center bg-[#050505] px-6 pt-24 pb-16 overflow-hidden">
                <div class="absolute inset-0 -z-10 overflow-hidden">
                    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-600/15 blur-[120px] animate-pulse"></div>
                    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-600/15 blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30%] h-[30%] rounded-full bg-blue-400/5 blur-[100px]"></div>
                    
                    <div class="absolute left-10 top-1/2 -translate-y-1/2 hidden lg:block">
                        <span class="text-[10px] font-mono uppercase tracking-[1em] text-neutral-800 [writing-mode:vertical-lr]">
                            {t('hero.side')}
                        </span>
                    </div>
                </div>

                <div class="max-w-7xl w-full">
                    <div class="flex flex-col gap-10">
                        <div class="flex items-center gap-4 animate-fade-in">
                            <div class="flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/5 backdrop-blur-md">
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                                </span>
                                <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-blue-400">{t('hero.remote')}</span>
                            </div>
                            <span class="text-[9px] uppercase tracking-[0.4em] text-neutral-400 font-medium">{t('hero.bilingual')}</span>
                        </div>

                        <div class="relative">
                            <h1 class="text-[16vw] lg:text-[min(13rem,15vw)] font-black leading-[0.8] tracking-tighter text-white px-2 cursor-default">
                                <span class="inline-block transition-all duration-500 hover:blur-[25px] hover:opacity-30">FELIX</span> <br/>
                                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-500 to-white/90 italic pr-8 inline-block transition-all duration-500 hover:blur-[25px] hover:opacity-60">CORCORAN</span>
                            </h1>

                            <div class="mt-8 flex flex-col md:flex-row md:items-end gap-6">
                                <!-- Sin minúsculas forzadas: «IA» / «AI» se leen como siglas -->
                                <p class="text-3xl md:text-5xl font-extralight text-neutral-400 leading-none tracking-tighter">
                                    {lang === 'es' ? (
                                        <>{t('hero.title.1')}{' '}<span class="text-white italic">{t('hero.title.2')}</span> & <br class="hidden md:block"/> {t('hero.title.3')}{' '}<span class="text-blue-500 font-normal">{t('hero.title.4')}</span>.</>
                                    ) : (
                                        <><span class="text-white italic">{t('hero.title.1')}</span> {t('hero.title.2')} & <br class="hidden md:block"/> <span class="text-blue-500 font-normal">{t('hero.title.3')}</span> {t('hero.title.4')}.</>
                                    )}
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 mt-0 md:mt-10">
                            <div class="lg:col-span-7">
                                <p class="text-xl md:text-2xl font-light text-neutral-300 leading-snug">
                                    {t('hero.degree')} <span class="text-white font-medium underline decoration-blue-500/30 underline-offset-8">{t('hero.degree.short')}</span>.
                                    {t('hero.desc')}
                                </p>
                            </div>
                            
                            <div class="lg:col-span-5 flex flex-col justify-end gap-8 md:gap-10">
                                <a href="#proyectos" class="group relative flex items-end gap-4 px-2">
                                    <div class="relative overflow-hidden pr-6"> 
                                        <span class="block text-4xl md:text-5xl font-black uppercase tracking-tighter text-white transition-transform duration-500 group-hover:-translate-y-full">{t('btn.projects')}</span>
                                        <span class="absolute top-0 left-0 block text-4xl md:text-5xl font-black uppercase tracking-tighter text-blue-500 italic transition-transform duration-500 translate-y-full group-hover:translate-y-0">{t('btn.projects')}</span>
                                    </div>
                                    <div class="mb-2 h-px w-0 bg-neutral-500 transition-all duration-500 group-hover:w-12 opacity-50 group-hover:opacity-100"></div>
                                </a>

                                <!-- El currículum en el idioma de la página: se descarga directamente -->
                                <a href={lang === 'en' ? '/resume-felix-corcoran.pdf' : '/cv-felix-corcoran.pdf'} download={lang === 'en' ? 'Resume-Felix-Corcoran.pdf' : 'CV-Felix-Corcoran.pdf'} class="group relative flex items-end gap-4">
                                    <div class="relative overflow-hidden">
                                        <span class="block text-4xl md:text-5xl font-black uppercase tracking-tighter text-neutral-300 transition-transform duration-500 group-hover:-translate-y-full">{t('btn.cv')}</span>
                                        <span class="absolute top-0 left-0 block text-4xl md:text-5xl font-black uppercase tracking-tighter text-indigo-400 transition-transform duration-500 translate-y-full group-hover:translate-y-0">{t('btn.download')}</span>
                                    </div>
                                    <div class="mb-3 flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-blue-400 opacity-0 group-hover:opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400 group-hover:bg-blue-500 transition-colors duration-500"></span>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <!-- Contacto directo desde la portada: entran de uno en uno desde la izquierda -->
                        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 font-mono text-[11px] tracking-[0.25em] uppercase">
                            {[
                                { label: 'LinkedIn', href: persona.links.linkedin },
                                { label: 'GitHub', href: persona.links.github },
                                { label: persona.email, href: `mailto:${persona.email}` },
                            ].map((link, i) => (
                                <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="hero-link group inline-flex items-center gap-2 text-white/75 hover:text-white transition-colors" style={`--i: ${i}`}>
                                    <span class="relative">
                                        {link.label}
                                        <span class="absolute left-0 -bottom-1 h-px w-full origin-left scale-x-0 bg-blue-400 transition-transform duration-500 group-hover:scale-x-100"></span>
                                    </span>
                                    <span class="text-blue-400 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
                                </a>
                            ))}
                        </div>

                        <div class="mt-0 md:mt-12 pt-0 md:pt-10 border-t border-white/5 flex flex-wrap gap-x-12 gap-y-2 md:gap-y-6 opacity-50">
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">n8n / AI APIs</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">PHP / Laravel</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">Astro / React</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">MySQL / REST API</span>
                        </div>
                    </div>
                </div>
            </section>

            <section id="proyectos" class="py-32 px-6 bg-[#050505]">
                <div class="max-w-7xl mx-auto">
                    <div class="flex flex-col mb-24 space-y-4">
                        <!-- «MIS» sube al llegar; el contorno de «TRABAJOS» se rellena con el
                             degradado de «CORCORAN» a medida que se hace scroll (script) -->
                        <h2 id="projects-title" data-reveal class="text-[clamp(2.75rem,15vw,4.2rem)] md:text-[8rem] font-black text-white tracking-tighter uppercase italic leading-none">
                            <span class="block overflow-hidden pr-4">
                                <span class="rv-up block">{t('projects.section.title')}</span>
                            </span>
                            <span class="relative block pr-4">
                                <span class="block text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.4);">{t('projects.section.subtitle')}</span>
                                <span id="projects-fill" class="absolute inset-0 block pr-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-500 to-white/90" style="clip-path: inset(0 100% 0 0);" aria-hidden="true">{t('projects.section.subtitle')}</span>
                            </span>
                        </h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                        
                        <!-- Los proyectos (de perfil.ts), a la mitad y con la misma tarjeta. Sin
                             enlace (p. ej. el radar, repositorio privado): sin capa al pasar el ratón -->
                        {halfCards.map((project, i) => {
                            const Card = project.url ? 'a' : 'div';
                            return (
                            <Card {...(project.url ? { href: project.url, target: '_blank', rel: 'noopener' } : {})} data-reveal class:list={['project-card md:col-span-6 group relative overflow-hidden bg-neutral-900/40 border border-white/5 rounded-[2.5rem] flex flex-col transition-colors duration-700', project.url && 'hover:border-blue-500/50']}>
                                {project.image && (
                                    <div class="rv-wipe relative aspect-[16/10] overflow-hidden border-b border-white/5" style={`--i: ${i % 2}`}>
                                        <Image src={project.image} alt={project.name.replace('\u200b', '')} widths={[600, 900, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover object-top transition-transform duration-[1400ms] ease-out group-hover:scale-[1.06]" />
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/0 to-black/0 opacity-60 transition-opacity duration-500 group-hover:opacity-100"></div>
                                        {project.url && (
                                            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 md:p-8 translate-y-full transition-transform duration-500 ease-out group-hover:translate-y-0">
                                                <span class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white leading-none">{project.action}</span>
                                                <span class="font-mono text-[11px] uppercase tracking-[0.3em] text-blue-300">{project.hover} ↗</span>
                                            </div>
                                        )}
                                    </div>
                                )}
                                <div class="rv-fade relative z-10 p-8 md:p-12 flex flex-1 flex-col justify-between gap-8" style={`--i: ${(i % 2) + 2}`}>
                                    <div>
                                        <div class="flex flex-wrap items-center gap-3 mb-5">
                                            <span class="text-[11px] font-bold text-blue-400 uppercase tracking-widest">{project.tag}</span>
                                            {project.status && <span class="px-2.5 py-1 rounded-full border border-white/20 text-[10px] text-white/70 uppercase font-bold tracking-widest">{project.status}</span>}
                                        </div>
                                        <h3 class="text-[clamp(1.75rem,6vw,3rem)] md:text-[clamp(1.75rem,3.2vw,3rem)] font-black text-white tracking-tighter uppercase mb-5 leading-[0.9]">{project.name}</h3>
                                        <p class="text-neutral-300 text-lg leading-relaxed">
                                            {project.desc}
                                        </p>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {project.chips.map((chip) => (
                                            <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-white/75 uppercase font-bold">{chip}</span>
                                        ))}
                                    </div>
                                </div>
                                <span class="absolute -bottom-10 -right-6 text-[16rem] font-black text-white/[0.02] select-none pointer-events-none" aria-hidden="true">{project.mark}</span>
                            </Card>
                            );
                        })}

                        <!-- Tarjetas anchas (wide en perfil.ts): bajas y discretas, al final. Spain
                             Trading Cards aún no es pública: lleva al caso contado en felixcorcoran.es -->
                        {wideCards.map((project) => (
                        <a href={project.url} target="_blank" rel="noopener" data-reveal class="md:col-span-12 group relative overflow-hidden bg-neutral-900/30 border border-white/5 rounded-[2.5rem] grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] transition-colors duration-700 hover:border-blue-500/50">
                            <div class="rv-fade p-8 md:p-12 flex flex-col justify-center gap-6 order-2 lg:order-1" style="--i: 2">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span class="text-[11px] font-bold text-blue-400 uppercase tracking-widest">{project.tag}</span>
                                    {project.status && <span class="px-2.5 py-1 rounded-full border border-amber-400/40 text-[10px] text-amber-300/90 uppercase font-bold tracking-widest">{project.status}</span>}
                                </div>
                                <h3 class="text-3xl md:text-5xl font-black text-white tracking-tighter uppercase leading-[0.9]">{project.name}</h3>
                                <p class="text-neutral-300 text-lg leading-relaxed">
                                    {project.desc}
                                </p>
                                <div class="flex flex-wrap gap-2">
                                    {project.chips.map((tech) => (
                                        <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-white/75 uppercase font-bold">{tech}</span>
                                    ))}
                                </div>
                                <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.3em] text-blue-300">
                                    {project.action}
                                    <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
                                </span>
                            </div>
                            {project.image && (
                                <div class="rv-wipe-x relative min-h-[16rem] overflow-hidden order-1 lg:order-2 border-b lg:border-b-0 lg:border-l border-white/5">
                                    <Image src={project.image} alt={project.name} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-left-top transition-transform duration-[1400ms] ease-out group-hover:scale-[1.05]" />
                                    <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"></div>
                                </div>
                            )}
                        </a>
                        ))}

                        <div class="md:col-span-12 p-5 pt-10 sm:p-10 md:p-20 bg-neutral-900/20 border border-white/5 rounded-[3rem]">
                            
                            <!-- Cabecera: la etiqueta sube, el titular entra palabra a palabra,
                                 el subtítulo aparece y la línea de debajo se dibuja -->
                            <div data-reveal class="relative flex flex-col md:flex-row md:items-end justify-between mb-20 pb-10">
                                <div>
                                    <span class="block overflow-hidden mb-4">
                                        <span class="rv-up block text-[10px] font-bold text-blue-400 uppercase tracking-widest">
                                            {t('projects.freelance.label')}
                                        </span>
                                    </span>
                                    <h3 class="text-[clamp(2rem,10vw,3rem)] md:text-6xl font-black text-white uppercase tracking-tighter">
                                        {t('projects.freelance.title').split(' ').map((word, i) => (
                                            <><span class="inline-block overflow-hidden align-bottom pb-1"><span class="rv-word inline-block" style={`--i: ${i + 1}`}>{word}</span></span>{' '}</>
                                        ))}
                                    </h3>
                                </div>
                                <p class="rv-fade text-neutral-300 font-mono text-xs uppercase tracking-widest italic mb-2" style="--i: 4">
                                    {t('projects.freelance.sub')}
                                </p>
                                <span class="rv-line absolute left-0 right-0 bottom-0 h-px bg-gradient-to-r from-blue-400/60 via-indigo-500/30 to-white/5" aria-hidden="true"></span>
                            </div>

                            <!-- Las tarjetas entran escalonadas al llegar a la galería -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                                {clientSites.map((site, index) => (
                                    <a
                                        href={site.url}
                                        target="_blank"
                                        rel="noopener"
                                        data-reveal
                                        class="rv-card group relative rounded-[2rem] overflow-hidden border border-white/5 bg-[#080808] block isolate transition-colors duration-700 hover:border-blue-500/40"
                                        style={`--i: ${index % 3}`}
                                    >
                                        <div class="relative aspect-[16/10] overflow-hidden">
                                            <Image src={site.image} alt={site.name} widths={[400, 700]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" class="h-full w-full object-cover object-top grayscale-[40%] transition-all duration-[1200ms] ease-out group-hover:grayscale-0 group-hover:scale-[1.07]" />
                                            <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-[#080808]/10 to-transparent"></div>
                                            <span class="absolute top-4 left-5 text-[10px] font-bold text-blue-200 uppercase tracking-[0.35em] drop-shadow">// {site.cat}</span>
                                            <span class="absolute -bottom-6 right-4 text-[6rem] font-black text-white/[0.06] leading-none transition-all duration-700 group-hover:-translate-y-2 group-hover:text-blue-400/20">0{index + 1}</span>
                                        </div>
