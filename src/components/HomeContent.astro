---
import '../styles/global.css';
import { useTranslations } from '../utils/i18n';

const title = "Félix Corcoran | Full Stack & AI Automation";
const { lang = 'es' } = Astro.props; 
const t = useTranslations(lang);

// URLs absolutas para buscadores y redes: la página en cada idioma
const site = Astro.site ?? new URL('https://dev.felixcorcoran.es');
const urlEs = new URL('/', site).href;
const urlEn = new URL('/en/', site).href;
const canonical = lang === 'en' ? urlEn : urlEs;
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <!-- El monograma «fc» de la marca, en la paleta oscura e índigo del portfolio -->
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={t('seo.description')}>
        <title>{title}</title>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={urlEs} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlEs} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={t('seo.description')} />
        <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
        <meta property="og:image" content={new URL('/og.png', site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>
    <body class="bg-neutral-950 text-white selection:bg-blue-500/30 font-sans">
        
        <nav class="fixed top-6 right-6 z-50 flex items-center gap-2 font-mono text-[10px] tracking-[0.3em] uppercase bg-neutral-900/40 backdrop-blur-md px-4 py-2 rounded-full border border-white/5">
            <a href="/" class={lang === 'es' ? 'text-blue-400 font-bold' : 'text-neutral-500 hover:text-white transition-colors duration-300'}>ES</a>
            <span class="text-neutral-800">/</span>
            <a href="/en/" class={lang === 'en' ? 'text-indigo-400 font-bold' : 'text-neutral-500 hover:text-white transition-colors duration-300'}>EN</a>
        </nav>
        
        <main>
            <section class="relative min-h-screen flex items-center justify-center bg-[#050505] px-6 overflow-hidden">
                <div class="absolute inset-0 -z-10 overflow-hidden">
                    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-600/15 blur-[120px] animate-pulse"></div>
                    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-600/15 blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30%] h-[30%] rounded-full bg-blue-400/5 blur-[100px]"></div>
                    
                    <div class="absolute left-10 top-1/2 -translate-y-1/2 hidden lg:block">
                        <span class="text-[10px] font-mono uppercase tracking-[1em] text-neutral-800 [writing-mode:vertical-lr]">
                            Logic • Design • Intelligence • 2026
                        </span>
                    </div>
                </div>

                <div class="max-w-7xl w-full">
                    <div class="flex flex-col gap-10">
                        <div class="flex items-center gap-4 animate-fade-in">
                            <div class="flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/5 backdrop-blur-md">
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                                </span>
                                <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-blue-400">Remote Ready</span>
                            </div>
                            <span class="text-[9px] uppercase tracking-[0.4em] text-neutral-400 font-medium">Bilingual ES/EN</span>
                        </div>

                        <div class="relative">
                            <h1 class="text-[16vw] lg:text-[13rem] font-black leading-[0.8] tracking-tighter text-white px-2 cursor-default">
                                <span class="inline-block transition-all duration-500 hover:blur-[25px] hover:opacity-30">FELIX</span> <br/>
                                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-500 to-white/90 italic pr-8 inline-block transition-all duration-500 hover:blur-[25px] hover:opacity-60">CORCORAN</span>
                            </h1>

                            <div class="mt-8 flex flex-col md:flex-row md:items-end gap-6">
                                <!-- Sin minúsculas forzadas: «IA» / «AI» se leen como siglas -->
                                <p class="text-3xl md:text-5xl font-extralight text-neutral-400 leading-none tracking-tighter">
                                    {lang === 'es' ? (
                                        <>{t('hero.title.1')}{' '}<span class="text-white italic">{t('hero.title.2')}</span> & <br class="hidden md:block"/> {t('hero.title.3')}{' '}<span class="text-blue-500 font-normal">{t('hero.title.4')}</span>.</>
                                    ) : (
                                        <><span class="text-white italic">{t('hero.title.1')}</span> {t('hero.title.2')} & <br class="hidden md:block"/> <span class="text-blue-500 font-normal">{t('hero.title.3')}</span> {t('hero.title.4')}.</>
                                    )}
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 mt-0 md:mt-10">
                            <div class="lg:col-span-7">
                                <p class="text-xl md:text-2xl font-light text-neutral-400 leading-snug">
                                    {t('hero.degree')} <span class="text-white font-medium underline decoration-blue-500/30 underline-offset-8">{t('hero.degree.short')}</span>.
                                    {t('hero.desc')}
                                </p>
                            </div>
                            
                            <div class="lg:col-span-5 flex flex-col justify-end gap-8 md:gap-10">
                                <a href="#proyectos" class="group relative flex items-end gap-4 px-2">
                                    <div class="relative overflow-hidden pr-6"> 
                                        <span class="block text-4xl md:text-5xl font-black uppercase tracking-tighter text-white transition-transform duration-500 group-hover:-translate-y-full">{t('btn.projects')}</span>
                                        <span class="absolute top-0 left-0 block text-4xl md:text-5xl font-black uppercase tracking-tighter text-blue-500 italic transition-transform duration-500 translate-y-full group-hover:translate-y-0">{t('btn.projects')}</span>
                                    </div>
                                    <div class="mb-2 h-px w-0 bg-neutral-500 transition-all duration-500 group-hover:w-12 opacity-50 group-hover:opacity-100"></div>
                                </a>

                                <!-- El currículum en el idioma de la página: se descarga directamente -->
                                <a href={lang === 'en' ? '/resume-felix-corcoran.pdf' : '/cv-felix-corcoran.pdf'} download={lang === 'en' ? 'Resume-Felix-Corcoran.pdf' : 'CV-Felix-Corcoran.pdf'} class="group relative flex items-end gap-4">
                                    <div class="relative overflow-hidden">
                                        <span class="block text-4xl md:text-5xl font-black uppercase tracking-tighter text-neutral-300 transition-transform duration-500 group-hover:-translate-y-full">{t('btn.cv')}</span>
                                        <span class="absolute top-0 left-0 block text-4xl md:text-5xl font-black uppercase tracking-tighter text-indigo-400 transition-transform duration-500 translate-y-full group-hover:translate-y-0">{t('btn.download')}</span>
                                    </div>
                                    <div class="mb-3 flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-blue-400 opacity-0 group-hover:opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400 group-hover:bg-blue-500 transition-colors duration-500"></span>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <div class="mt-0 md:mt-20 pt-0 md:pt-10 border-t border-white/5 flex flex-wrap gap-x-12 gap-y-2 md:gap-y-6 opacity-50">
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">n8n / AI APIs</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">PHP / Laravel</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">Astro / React</span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.5em]">MySQL / REST API</span>
                        </div>
                    </div>
                </div>
            </section>

            <section id="tech" class="py-24 md:py-40 px-6 bg-black overflow-hidden">
                <div class="max-w-7xl mx-auto">

                    <div class="flex flex-col lg:flex-row gap-6 lg:items-end mb-24 md:mb-48 border-b border-white/5 pb-10">
                        <h2 id="stack-title" class="text-[22vw] lg:text-[9vw] font-black leading-[0.7] tracking-tighter text-white">
                            STACK
                        </h2>
                        <div class="flex-1 lg:pl-10">
                            <p class="text-lg md:text-2xl font-extralight text-neutral-300 max-w-md leading-none lowercase tracking-tighter italic">
                                {t('stack.tagline.1')} <br/> {t('stack.tagline.2')}
                            </p>
                        </div>
                    </div>
                    
                    <div class="flex flex-col lg:grid lg:grid-cols-12 gap-y-32 lg:gap-x-12 xl:gap-x-20 items-start">
                        
                        <div class="w-full lg:col-span-7 group/section">
                            <div class="relative space-y-6 md:space-y-10">
                                <div class="flex items-center gap-6 text-blue-500 font-mono text-xs tracking-widest uppercase">
                                    <span>01</span>
                                    <div class="h-px flex-1 bg-blue-500/20"></div>
                                    <span>Backend & Architecture</span>
                                </div>
                                
                                <div class="group/section py-2 cursor-default">
                                    <h3 class="text-5xl md:text-7xl xl:text-8xl font-bold leading-none tracking-tighter uppercase">
                                        
                                        <span class="block text-white transition-all duration-500 
                                            group-hover/section:text-transparent 
                                            group-hover/section:[-webkit-text-stroke:1px_rgba(255,255,255,0.5)]">
                                            SOFTWARE
                                        </span>

                                        <span class="block transition-all duration-500 
                                            text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,0.3)]
                                            group-hover/section:text-blue-500 
                                            group-hover/section:italic 
                                            group-hover/section:[-webkit-text-stroke:0px]">
                                            ENGINEERING
                                        </span>
                                        
                                    </h3>
                                </div>
                                
                                <p class="text-neutral-300 text-xl md:text-3xl lg:text-2xl xl:text-2xl font-light leading-relaxed max-w-2xl">
                                    {t('tech.backend')}
                                </p>

                                <div class="flex flex-wrap gap-4 pt-4">
                                    {['php', 'laravel', 'nodejs', 'java', 'mysql'].map((tech) => (
                                        <div class="group/tech relative flex flex-col items-center">
                                            <img src={`https://skillicons.dev/icons?i=${tech}`} 
                                                class="h-14 w-14 transition-all duration-300 grayscale-0 group-hover/section:grayscale group-hover/tech:grayscale-0 group-hover/tech:scale-110" 
                                                alt={tech} />
                                            <div class="absolute -bottom-2 w-0 h-px bg-blue-500 group-hover/tech:w-full transition-all duration-500"></div>
                                            <span class="absolute -bottom-8 text-[10px] font-mono text-blue-500 opacity-0 group-hover/tech:opacity-100 uppercase tracking-tighter">
                                                {tech}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>

                        <div class="w-full lg:col-span-5 flex flex-col justify-end items-end lg:items-start group/section lg:pt-20 border-t lg:border-white/5 border-black pt-0 lg:border-none">                   
                            
                            <div class="space-y-6 md:space-y-10 relative flex flex-col items-end lg:items-start w-full">
                                
                                <div class="flex flex-row-reverse lg:flex-row items-center gap-6 text-indigo-500 font-mono text-xs tracking-widest uppercase w-full">
                                    <span>02</span>
                                    <div class="h-px flex-1 bg-indigo-500/20"></div>
                                    <span>Frontend & UI</span>
                                </div>
                                
                                <div class="relative overflow-hidden group/reveal py-2 cursor-default text-right lg:text-left w-full">
                                    <h3 class="text-5xl md:text-8xl font-bold text-white leading-none transition-transform duration-500 group-hover/reveal:-translate-y-[110%] tracking-tighter">
                                        VISUAL <br/> FIDELITY
                                    </h3>
                                    
                                    <h3 class="text-5xl md:text-8xl font-bold leading-none absolute top-full right-0 lg:right-auto lg:left-0 transition-transform duration-500 group-hover/reveal:-translate-y-[110%] italic tracking-tighter w-full">
                                        <span class="text-indigo-400">VISUAL</span> <br/> 
                                        <span class="text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.5);">FIDELITY</span>
                                    </h3>
                                </div>

                                <p class="text-neutral-300 text-xl md:text-3xl lg:text-md xl:text-xl font-light leading-snug max-w-2xl text-right lg:text-left">
                                    {t('tech.frontend')}
                                </p>
                                
                                <div class="flex flex-wrap justify-end lg:justify-start gap-4 pt-4 w-full">
                                    {['astro', 'react', 'ts', 'tailwind', 'threejs', 'js', 'vite', 'sass'].map((tech) => (
                                        <div class="group/tech relative flex flex-col items-center">
                                            <img src={`https://skillicons.dev/icons?i=${tech}`} 
                                                class="h-14 w-14 transition-all duration-300 grayscale-0 group-hover/section:grayscale group-hover/tech:grayscale-0 group-hover/tech:scale-110" 
                                                alt={tech} />
                                            <div class="absolute -bottom-2 w-0 h-px bg-indigo-500 group-hover/tech:w-full transition-all duration-500"></div>
                                            <span class="absolute -bottom-8 text-[10px] font-mono text-indigo-500 opacity-0 group-hover/tech:opacity-100 uppercase tracking-tighter">
                                                {tech}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>

                        <div class="md:col-span-12 border-t border-black lg:border-white/5 pt-0 lg:pt-32 group/section">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                                <div class="lg:col-span-5 space-y-10">
                                    <div class="flex items-center gap-6 text-blue-400 font-mono text-xs tracking-widest uppercase">
                                        <span>03</span>
                                        <div class="h-px flex-1 bg-blue-400/20"></div>
                                        <span>AI Orchestration</span>
                                    </div>
                                    
                                    <h3 class="text-[8rem] lg:text-[16rem] md:text-[12rem] font-black leading-none text-transparent transition-all duration-700 select-none cursor-default
                                        [-webkit-text-stroke:4px_rgba(255,255,255,0.4)] 
                                        group-hover/section:text-white 
                                        group-hover/section:[-webkit-text-stroke:4px_#60a5fa]">
                                        n8n
                                    </h3>
                                </div>
                                
                                <div class="lg:col-span-7 flex flex-col justify-center space-y-12">
                                    <p class="text-3xl md:text-5xl text-white font-extralight leading-tight tracking-tighter">
                                        {t('tech.automation')}
                                    </p>
                                                                        
                                    <!-- Los proveedores de IA no tienen icono en skillicons: van como etiquetas
                                         (el antiguo icono «ai» era el logo de Adobe Illustrator) -->
                                    <div class="flex flex-wrap gap-2">
                                        {['n8n', 'OpenAI API', 'Claude API', 'Gemini API', 'Shopify GraphQL API', 'Telegram Bot API', 'Google Places API', 'JSON', 'REST API'].map((tool) => (
                                            <span class="px-4 py-2 rounded-full bg-blue-500/5 border border-blue-400/20 text-xs text-blue-200/80 uppercase font-bold tracking-wider">{tool}</span>
                                        ))}
                                    </div>

                                    <div class="flex flex-wrap gap-4 pt-4">
                                        {['docker', 'git', 'githubactions', 'vercel', 'postman'].map((tech) => (
                                            <div class="group/tech relative flex flex-col items-center">
                                                <img src={`https://skillicons.dev/icons?i=${tech}`} 
                                                    class="h-14 w-14 transition-all duration-300 grayscale-0 group-hover/section:grayscale group-hover/tech:grayscale-0 group-hover/tech:scale-110" 
                                                    alt={tech} />
                                                <div class="absolute -bottom-2 w-0 h-px bg-blue-400 group-hover/tech:w-full transition-all duration-500"></div>
                                                <span class="absolute -bottom-8 text-[10px] font-mono text-blue-400 opacity-0 group-hover/tech:opacity-100 uppercase tracking-tighter">
                                                    {tech}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="md:col-span-12 border-t lg:border-white/5 border-black lg:pt-32 pt-0 group/section">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                                
                                <div class="lg:col-span-5 flex justify-center lg:justify-start relative overflow-visible hidden lg:flex">
                                    <div class="relative -ml-40">
                                        <svg 
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="700"
                                            height="700"
                                            viewBox="0 0 100 100"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="text-indigo-500/10 animate-[spin_40s_linear_infinite] transition-colors duration-1000 group-hover/section:text-indigo-500/30"
                                        >
                                            <path d="
                                                M50 4
                                                L60 4
                                                L63 15
                                                L73 19
                                                L82 11
                                                L89 18
                                                L81 27
                                                L85 37
                                                L96 40
                                                L96 50
                                                L85 53
                                                L81 63
                                                L89 72
                                                L82 79
                                                L73 71
                                                L63 75
                                                L60 86
                                                L50 86
                                                L47 75
                                                L37 71
                                                L28 79
                                                L21 72
                                                L29 63
                                                L25 53
                                                L14 50
                                                L14 40
                                                L25 37
                                                L29 27
                                                L21 18
                                                L28 11
                                                L37 19
                                                L47 15
                                                Z
                                            " />

                                            <circle cx="55" cy="45" r="13"></circle>
                                        </svg>
                                    </div>
                                </div>

                                <div class="lg:col-start-6 lg:col-span-7 flex flex-col lg:items-end lg:text-right space-y-10 group/section w-full">
                                    
                                    <div class="flex flex-row-reverse items-center gap-6 text-indigo-500 font-mono text-xs tracking-widest uppercase w-full">
                                        <span>04</span>
                                        <div class="h-px flex-1 bg-indigo-500/20"></div>
                                        <span class="text-indigo-400">Continuous Learning</span>
                                    </div>
                                    
                                    <div class="cursor-default overflow-hidden w-full lg:flex lg:justify-end">
                                        <h3 class="text-6xl md:text-[8rem] lg:text-[9rem] font-black leading-[0.8] uppercase tracking-tighter text-right">
                                            <div class="relative block h-[0.9em] overflow-hidden">
                                                <span class="absolute right-0 transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]
                                                    text-transparent [-webkit-text-stroke:2px_rgba(255,255,255,0.4)]
                                                    group-hover/section:translate-x-full
                                                    group-hover/section:opacity-0 whitespace-nowrap">
                                                    NEW
                                                </span>
                                                <span class="absolute right-0 translate-x-[-120%] opacity-0
                                                    transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]
                                                    text-white
                                                    group-hover/section:translate-x-0
                                                    group-hover/section:opacity-100 whitespace-nowrap">
                                                    NEW
                                                </span>
                                            </div>
                                            <span class="block transition-all duration-500 text-white group-hover/section:text-indigo-400 group-hover/section:italic group-hover/section:-translate-x-4">
                                                HORIZONS
                                            </span>
                                        </h3>
                                    </div>

                                    <p class="text-neutral-400 text-xl md:text-3xl font-light leading-relaxed w-full lg:max-w-xl ml-auto text-right">
                                        {t('tech.future')}
                                    </p>

                                    <div class="flex flex-wrap gap-4 justify-end w-full">
                                        {[
                                            {id: 'nextjs', name: 'Next.js'},
                                            {id: 'supabase', name: 'Supabase'}
                                        ].map((tech) => (
                                            <div class="group/tech relative flex flex-col items-center">
                                                <img 
                                                    src={`https://skillicons.dev/icons?i=${tech.id}`} 
                                                    class="h-14 w-14 transition-all duration-500 grayscale-0 group-hover/section:grayscale group-hover/tech:grayscale-0 group-hover/tech:scale-110" 
                                                    alt={tech.name} 
                                                />
                                                <div class="absolute -bottom-2 w-0 h-px bg-indigo-500 group-hover/tech:w-full transition-all duration-500"></div>
                                                <span class="absolute -bottom-8 text-[10px] font-mono text-indigo-500 opacity-0 group-hover/tech:opacity-100 uppercase tracking-tighter whitespace-nowrap">
                                                    {tech.name}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Experiencia: lo mismo que el currículum. Una línea de tiempo que se dibuja con el
                 scroll; cada puesto entra al llegar y reacciona al pasar el ratón -->
            <section id="experiencia" class="relative py-32 md:py-40 px-6 bg-black border-t border-white/5 overflow-hidden">
                <div class="relative max-w-7xl mx-auto">
                    <div class="flex items-center gap-6 text-blue-500 font-mono text-xs tracking-[0.3em] uppercase mb-16 md:mb-24">
                        <span>{t('exp.label')}</span>
                        <div class="h-px flex-1 bg-blue-500/20"></div>
                    </div>

                    <h2 id="exp-title" class="text-[clamp(2.25rem,11vw,8rem)] font-black text-white tracking-tighter uppercase leading-none mb-16 md:mb-24">
                        <span class="block overflow-hidden">
                            <span class="exp-title-line block">{t('exp.title')}</span>
                        </span>
                    </h2>

                    <ol id="exp-list" class="relative pl-8 md:pl-16">
                        <!-- La línea de tiempo: el relleno crece con el scroll (script) -->
                        <span class="absolute left-0 top-0 bottom-0 w-px bg-white/10" aria-hidden="true">
                            <span id="exp-progress" class="absolute inset-0 origin-top bg-gradient-to-b from-blue-400 via-indigo-500 to-indigo-500/0"></span>
                        </span>

                        {[
                            {
                                role: t('exp.freelance.role'),
                                place: 'Freelance',
                                period: t('exp.freelance.period'),
                                desc: t('exp.freelance.desc'),
                                tags: lang === 'en' ? ['MVC', 'Online bookings', 'Client-facing'] : ['MVC', 'Reservas online', 'Trato con cliente'],
                            },
                            {
                                role: t('exp.sti.role'),
                                place: 'Simply Trade In',
                                period: t('exp.sti.period'),
                                desc: t('exp.sti.desc'),
                                tags: ['n8n', 'JSON', 'UI/UX'],
                            },
                        ].map((job) => (
                            <li class="exp-row group relative py-12 md:py-16">
                                <!-- El punto de la línea de tiempo: se enciende al llegar -->
