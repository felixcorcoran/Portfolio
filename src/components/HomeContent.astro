    .anim [data-reveal]:not(.is-in) :is(.rv-flap, .rv-key) { opacity: 0; }
    .anim [data-reveal]:not(.is-in) .rv-grow { transform: scaleX(0); }
    .anim .is-in .rv-flap { animation: rv-flap 0.8s cubic-bezier(0.22, 1, 0.36, 1) calc(0.15s + var(--k, 0) * 45ms) both; }
    .anim .is-in .rv-key { animation: rv-key 0.01s linear calc(var(--k, 0) * 70ms) both; }
